<section class="section">
  <div class="container">
    <div class="section__head"><div><div class="eyebrow"><%= t('nav.contact') %></div><h1><%= t('nav.contact') %></h1></div></div>

    <div class="grid grid--3">
      <div class="card"><div class="card__body">
        <h3 style="font-size:1rem"><%= t('contact.sendTitle') %></h3>
          <form id="contactForm">
            <div class="field">
              <label><%= t('contact.nameLabel') %></label>
              <input type="text" name="name" required />
            </div>
            <div class="field">
              <label><%= t('checkout.email') %></label>
              <input type="email" name="email" required />
            </div>
            <div class="field">
              <label><%= t('checkout.phone') %></label>
              <input type="tel" name="phone" />
            </div>
            <div class="field">
              <label><%= t('contact.subject') %></label>
              <input type="text" name="subject" />
            </div>
            <div class="field">
              <label><%= t('contact.message') %></label>
              <textarea name="message" required></textarea>
            </div>
            <button type="submit" class="btn btn--primary btn--block"><%= t('contact.submit') %></button>
          </form>
      </div></div>

      <div class="card"><div class="card__body">
        <h3 style="font-size:1rem"><%= t('checkout.contact') %></h3>
        <dl class="kv">
          <dt><%= t('common.address') %></dt><dd><%= site.address %></dd>
          <dt><%= t('footer.callCenter') %></dt><dd><%= site.supportPhone %></dd>
          <dt><%= t('checkout.phone') %></dt><dd><%= site.supportPhoneLandline %></dd>
          <dt><%= t('checkout.email') %></dt><dd><%= site.supportEmail %></dd>
        </dl>
      </div></div>

      <div class="card"><div class="card__body">
        <h3 style="font-size:1rem"><%= t('contact.hoursTitle') %></h3>
        <dl class="kv">
          <dt><%= t('contact.monFri') %></dt><dd>09:00 — 18:00</dd>
          <dt><%= t('contact.saturday') %></dt><dd>10:00 — 16:00</dd>
          <dt><%= t('contact.sunday') %></dt><dd><%= t('seats.blocked') %></dd>
        </dl>
        <div class="alert alert--info mt-16 mb-0 text-sm"><%= t('contact.callCenter24') %></div>
      </div></div>
    </div>
  </div>
</section>

<script>
  var contactForm = document.getElementById('contactForm');
  if (contactForm) {
    contactForm.addEventListener('submit', async function (e) {
      e.preventDefault();
      var btn = contactForm.querySelector('button[type=submit]');
      window.setLoading(btn, true);
      var r = await window.api('/api/contact', {
        name: contactForm.name.value,
        email: contactForm.email.value,
        phone: contactForm.phone ? contactForm.phone.value : '',
        subject: contactForm.subject ? contactForm.subject.value : '',
        message: contactForm.message.value
      });
      window.setLoading(btn, false);
      window.toast(r.message, r.ok ? 'success' : 'error');
      if (r.ok) { contactForm.reset(); }
    });
  }
</script>
