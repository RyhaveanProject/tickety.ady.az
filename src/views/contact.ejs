<section class="section">
  <div class="container">
    <div class="section__head"><div><div class="eyebrow"><%= t('nav.contact') %></div><h1><%= t('nav.contact') %></h1></div></div>

    <div class="grid grid--3">
      <div class="card"><div class="card__body">
        <h3 style="font-size:1rem">Müraciət göndər</h3>
          <form id="contactForm">
            <div class="field">
              <label>Ad, soyad</label>
              <input type="text" name="name" required />
            </div>
            <div class="field">
              <label>E-poçt</label>
              <input type="email" name="email" required />
            </div>
            <div class="field">
              <label>Telefon</label>
              <input type="tel" name="phone" />
            </div>
            <div class="field">
              <label>Mövzu</label>
              <input type="text" name="subject" />
            </div>
            <div class="field">
              <label>Müraciət</label>
              <textarea name="message" required></textarea>
            </div>
            <button type="submit" class="btn btn--primary btn--block">Göndər</button>
          </form>
      </div></div>

      <div class="card"><div class="card__body">
        <h3 style="font-size:1rem">Əlaqə məlumatları</h3>
        <dl class="kv">
          <dt>Ünvan</dt><dd><%= site.address %></dd>
          <dt>Çağrı mərkəzi</dt><dd><%= site.supportPhone %></dd>
          <dt>Telefon</dt><dd><%= site.supportPhoneLandline %></dd>
          <dt>E-poçt</dt><dd><%= site.supportEmail %></dd>
        </dl>
      </div></div>

      <div class="card"><div class="card__body">
        <h3 style="font-size:1rem">İş rejimi</h3>
        <dl class="kv">
          <dt>Bazar ertəsi — Cümə</dt><dd>09:00 — 18:00</dd>
          <dt>Şənbə</dt><dd>10:00 — 16:00</dd>
          <dt>Bazar</dt><dd>Bağlı</dd>
        </dl>
        <div class="alert alert--info mt-16 mb-0 text-sm">Çağrı mərkəzi günün bütün saatlarında fəaliyyət göstərir.</div>
      </div></div>
    </div>
  </div>
</section>

<script>
  var contactForm = document.getElementById('contactForm');
  if (contactForm) {
    contactForm.addEventListener('submit', async function (e) {
      e.preventDefault();
      var btn = contactForm.querySelector('button[type=submit]');
      window.setLoading(btn, true);
      var r = await window.api('/api/contact', {
        name: contactForm.name.value,
        email: contactForm.email.value,
        phone: contactForm.phone ? contactForm.phone.value : '',
        subject: contactForm.subject ? contactForm.subject.value : '',
        message: contactForm.message.value
      });
      window.setLoading(btn, false);
      window.toast(r.message, r.ok ? 'success' : 'error');
      if (r.ok) { contactForm.reset(); }
    });
  }
</script>
