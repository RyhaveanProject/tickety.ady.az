<section class="section">
  <div class="container">
    <div class="section__head">
      <div><div class="eyebrow"><%= t('home.travel') %></div><h1><%= t('nav.destinations') %></h1><p><%= t('home.popularSub') %></p></div>
    </div>

    <div class="grid grid--4">
      <% destinations.forEach(function(d){ %>
        <a href="/<%= locale %>/populyar-istiqametler/<%= d.slug %>" class="feature">
          <div class="feature__img">
            <svg class="ico ico--lg" viewBox="0 0 24 24"><path d="M4 15V7a3 3 0 0 1 3-3h10a3 3 0 0 1 3 3v8"/><rect x="2" y="15" width="20" height="4" rx="1"/><path d="M6 19v2M18 19v2M9 8h6"/></svg>
          </div>
          <div class="feature__body">
            <h3><%= d.title %></h3>
            <p><%= d.summary %></p>
            <span class="feature__link"><%= t('common.price') %>: <%= d.priceFrom.toFixed(2) %> ₼</span>
          </div>
        </a>
      <% }) %>
    </div>
  </div>
</section>
