<section class="section">
  <div class="container">
    <div class="section__head">
      <div><div class="eyebrow"><%= t('nav.panel') %></div><h1><%= t('admin.overview') %></h1></div>
      <a href="/<%= locale %>/admin/odenisler" class="btn btn--primary">
        <%= t('admin.payments') %> <% if (stats.pending) { %><span class="badge badge--red"><%= stats.pending %></span><% } %>
      </a>
    </div>

    <div class="layout-aside">
      <%- include('../../partials/admin-nav') %>

      <div>
        <div class="grid grid--4 mb-24">
          <div class="stat"><div class="stat__label"><%= t('admin.users') %></div><div class="stat__value"><%= stats.users %></div></div>
          <div class="stat"><div class="stat__label"><%= t('admin.orders') %></div><div class="stat__value"><%= stats.orders %></div></div>
          <div class="stat"><div class="stat__label"><%= t('nav.myTickets') %></div><div class="stat__value"><%= stats.tickets %></div></div>
          <div class="stat"><div class="stat__label">Gəlir</div><div class="stat__value"><%= stats.revenue.toFixed(2) %></div></div>
        </div>

        <div class="grid grid--3 mb-24">
          <div class="stat"><div class="stat__label">Təsdiq gözləyən ödəniş</div><div class="stat__value"><%= stats.pending %></div></div>
          <div class="stat"><div class="stat__label">Bugünkü reys</div><div class="stat__value"><%= stats.todayTrips %></div></div>
          <div class="stat"><div class="stat__label">Aktiv reys şablonu</div><div class="stat__value"><%= stats.trains %></div></div>
        </div>

        <div class="card mb-24">
          <div class="card__head"><span>Təsdiq gözləyən ödənişlər</span><a href="/<%= locale %>/admin/odenisler" class="btn btn--sm btn--outline"><%= t('home.seeAll') %></a></div>
          <div class="card__body">
            <% if (!pendingPayments.length) { %>
              <p class="sec-note mb-0">Təsdiq gözləyən ödəniş yoxdur.</p>
            <% } else { %>
              <div class="table-wrap"><table class="data">
                <thead><tr><th>Tranzaksiya</th><th>Kart</th><th><%= t('checkout.total') %></th><th><%= t('account.status') %></th><th></th></tr></thead>
                <tbody>
                  <% pendingPayments.forEach(function(p){ %>
                    <tr>
                      <td class="mono"><%= p.transactionId %></td>
                      <td class="mono"><%= p.card.masked %> <span class="sec-note"><%= p.card.brand %></span></td>
                      <td class="mono"><%= p.amount.toFixed(2) %> ₼</td>
                      <td><span class="badge badge--gray"><%= t('status.' + p.status) %></span></td>
                      <td><a href="/<%= locale %>/admin/odenisler" class="btn btn--sm btn--primary"><%= t('account.detail') %></a></td>
                    </tr>
                  <% }) %>
                </tbody>
              </table></div>
            <% } %>
          </div>
        </div>

        <div class="card mb-24">
          <div class="card__head"><span>Son sifarişlər</span><a href="/<%= locale %>/admin/sifarisler" class="btn btn--sm btn--outline"><%= t('home.seeAll') %></a></div>
          <div class="card__body">
            <div class="table-wrap"><table class="data">
              <thead><tr><th>Sifariş</th><th><%= t('table.route') %></th><th><%= t('common.date') %></th><th><%= t('checkout.total') %></th><th><%= t('account.status') %></th></tr></thead>
              <tbody>
                <% recentOrders.forEach(function(o){ %>
                  <tr>
                    <td class="mono"><%= o.orderNo %></td>
                    <td><%= o.fromName %> — <%= o.toName %></td>
                    <td><%= o.date %></td>
                    <td class="mono"><%= o.total.toFixed(2) %> ₼</td>
                    <td><span class="badge badge--gray"><%= t('status.' + o.status) %></span></td>
                  </tr>
                <% }) %>
              </tbody>
            </table></div>
          </div>
        </div>

        <div class="card">
          <div class="card__head"><span><%= t('admin.sync') %></span><a href="/<%= locale %>/admin/sinxronizasiya" class="btn btn--sm btn--outline"><%= t('home.seeAll') %></a></div>
          <div class="card__body">
            <% if (!lastSync) { %>
              <p class="sec-note mb-0">Sinxronizasiya hələ işlədilməyib.</p>
            <% } else { %>
              <dl class="kv">
                <dt>Vəziyyət</dt><dd><span class="badge badge--<%= lastSync.status === 'success' ? 'green' : lastSync.status === 'blocked' ? 'gold' : 'gray' %>"><%= lastSync.status %></span></dd>
                <dt>Vaxt</dt><dd><%= new Date(lastSync.createdAt).toLocaleString('az-AZ') %></dd>
                <dt>Stansiya</dt><dd><%= lastSync.stationsUpserted %></dd>
                <dt>Qatar</dt><dd><%= lastSync.trainsUpserted %></dd>
                <dt>Qeyd</dt><dd><%= lastSync.message || '—' %></dd>
              </dl>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
