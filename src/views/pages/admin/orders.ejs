<div class="page-head">
  <div class="container">
    <div class="breadcrumb"><a href="/<%= locale %>">Ana səhifə</a> <span>/</span> <a href="/<%= locale %>/admin">Panel</a> <span>/</span> <span>Sifarişlər</span></div>
    <h1>Sifarişlər</h1>
  </div>
</div>

<section class="section">
  <div class="container">
    <%- include('../../partials/admin-nav', { active: 'orders' }) %>

    <div class="card" style="margin-bottom:18px">
      <div class="card__body">
        <form method="GET" style="display:flex;gap:12px;align-items:flex-end;flex-wrap:wrap">
          <div class="field" style="margin:0;min-width:220px">
            <label>Axtarış</label>
            <input type="text" name="q" value="<%= q %>" placeholder="Sifariş № və ya qatar" />
          </div>
          <div class="field" style="margin:0;min-width:180px">
            <label>Status</label>
            <select name="status">
              <option value="">Hamısı</option>
              <option value="paid" <%= status === 'paid' ? 'selected' : '' %>>Ödənilib</option>
              <option value="pending" <%= status === 'pending' ? 'selected' : '' %>>Gözləyir</option>
              <option value="cancelled" <%= status === 'cancelled' ? 'selected' : '' %>>Ləğv edilib</option>
              <option value="refunded" <%= status === 'refunded' ? 'selected' : '' %>>Qaytarılıb</option>
            </select>
          </div>
          <button type="submit" class="btn btn--primary">Filtrələ</button>
        </form>
      </div>
    </div>

    <div class="card">
      <div class="card__head"><span><%= total %> sifariş</span></div>
      <div class="card__body" style="padding:0">
        <div class="table-wrap" style="border:0">
          <table class="data">
            <thead><tr><th>Sifariş №</th><th>İstifadəçi</th><th>Marşrut</th><th>Qatar</th><th>Tarix</th><th>Bilet</th><th>Məbləğ</th><th>Status</th></tr></thead>
            <tbody>
              <% orders.forEach(function(o){ %>
                <tr>
                  <td class="num"><%= o.orderNo %></td>
                  <td><%= o.user ? ((o.user.firstName || '') + ' ' + (o.user.lastName || '')) : '—' %><br /><small style="color:var(--muted)"><%= o.user ? o.user.email : '' %></small></td>
                  <td><%= o.fromName %> → <%= o.toName %></td>
                  <td class="num"><%= o.trainNumber %></td>
                  <td><%= o.date %> <%= o.departTime %></td>
                  <td class="num"><%= (o.passengers || []).length %></td>
                  <td class="num"><%= o.total.toFixed(2) %> ₼</td>
                  <td><span class="badge <%= o.status === 'paid' ? 'badge--green' : (o.status === 'pending' ? 'badge--gold' : 'badge--gray') %>"><%= o.status %></span></td>
                </tr>
              <% }) %>
              <% if (!orders.length) { %><tr><td colspan="8" style="text-align:center;color:var(--muted);padding:26px">Nəticə yoxdur</td></tr><% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <% if (pages > 1) { %>
      <div style="display:flex;gap:8px;justify-content:center;margin-top:20px">
        <% for (var p = 1; p <= pages; p++) { %>
          <a href="?page=<%= p %><%= status ? '&status=' + status : '' %><%= q ? '&q=' + encodeURIComponent(q) : '' %>" class="tbtn <%= p === page ? 'is-active' : '' %>"><%= p %></a>
        <% } %>
      </div>
    <% } %>
  </div>
</section>
