<section class="section">
  <div class="container">
    <div class="section__head">
      <div>
        <div class="eyebrow"><%= t('nav.panel') %></div>
        <h1><%= t('admin.sync') %></h1>
        <p><%= t('news.source') %> <a href="<%= sourceUrl %>" target="_blank" rel="noopener"><%= sourceUrl %></a></p>
      </div>
      <button class="btn btn--primary" data-admin-action="sync"><%= t('admin.runSyncBtn') %></button>
    </div>

    <div class="layout-aside">
      <%- include('../../partials/admin-nav') %>

      <div>
        <div class="grid grid--3 mb-24">
          <div class="stat"><div class="stat__label"><%= t('admin.autoSyncLabel') %></div><div class="stat__value" style="font-size:1.1rem"><%= enabled ? t('common.active') : t('admin.disabled') %></div></div>
          <div class="stat"><div class="stat__label"><%= t('admin.intervalLabel') %></div><div class="stat__value" style="font-size:1.1rem"><%= intervalHours %> <%= t('admin.hourSuffix') %></div></div>
          <div class="stat"><div class="stat__label"><%= t('admin.lastSyncLabel') %></div><div class="stat__value" style="font-size:1rem"><%= logs.length ? new Date(logs[0].createdAt).toLocaleString('az-AZ') : '—' %></div></div>
        </div>

        <div class="card mb-24"><div class="card__body">
          <h3 style="font-size:1rem"><%= t('admin.noticeTitle') %></h3>
          <p class="sec-note"><%= t('admin.noticeText') %></p>
          <div id="noticeNote" class="hidden"></div>
          <form id="noticeForm" class="mt-16">
            <div class="field">
              <label><%= t('admin.noticeLabel') %></label>
              <textarea name="notice" rows="3"><%= noticeValue %></textarea>
            </div>
            <div class="field">
              <label><%= t('admin.tickerLabel') %></label>
              <input type="text" name="ticker" value="<%= tickerValue %>" />
            </div>
            <button type="submit" class="btn btn--primary btn--sm"><%= t('account.save') %></button>
          </form>
        </div></div>

        <div class="card mb-24"><div class="card__body">
          <h3 style="font-size:1rem"><%= t('admin.howTitle') %></h3>
          <p class="sec-note mb-0"><%= t('admin.howText') %></p>
        </div></div>

        <div class="table-wrap">
          <table class="data">
            <thead>
              <tr><th><%= t('common.time') %></th><th><%= t('admin.statusCol') %></th><th><%= t('admin.http') %></th><th><%= t('home.statStations') %></th><th><%= t('table.train') %></th><th><%= t('admin.faresU') %></th><th><%= t('common.note') %></th></tr>
            </thead>
            <tbody>
              <% if (!logs.length) { %><tr><td colspan="7"><%= t('admin.noSyncLogs') %></td></tr><% } %>
              <% logs.forEach(function(l){ %>
                <tr>
                  <td class="sec-note"><%= new Date(l.createdAt).toLocaleString('az-AZ') %></td>
                  <td><span class="badge badge--<%= l.status === 'success' ? 'green' : l.status === 'blocked' ? 'gold' : l.status === 'failed' ? 'red' : 'gray' %>"><%= l.status %></span></td>
                  <td class="num"><%= l.httpStatus || '—' %></td>
                  <td class="num"><%= l.stationsUpserted %></td>
                  <td class="num"><%= l.trainsUpserted %></td>
                  <td class="num"><%= l.faresUpserted %></td>
                  <td class="sec-note"><%= l.message || '—' %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
(function () {
  function show(msg, ok) {
    var n = document.getElementById('noticeNote');
    if (!n) return;
    n.classList.remove('hidden');
    n.className = 'alert ' + (ok ? 'alert--success' : 'alert--error') + ' mb-16';
    n.textContent = msg;
  }
  var noticeForm = document.getElementById('noticeForm');
  if (noticeForm) {
    noticeForm.addEventListener('submit', async function (e) {
      e.preventDefault();
      var r = await window.api('/api/admin/settings/notice', {
        notice: noticeForm.querySelector('[name=notice]').value,
        ticker: noticeForm.querySelector('[name=ticker]').value
      });
      show(r.message || (r.ok ? window.T('admin.saved') : window.T('msg.operationFailed')), !!r.ok);
    });
  }
  var syncBtn = document.querySelector('[data-admin-action="sync"]');
  if (syncBtn) {
    syncBtn.addEventListener('click', async function () {
      window.setLoading(syncBtn, true);
      var r = await window.api('/api/admin/sync/run', {});
      window.setLoading(syncBtn, false);
      show(r.message || (r.ok ? window.T('admin.completed') : window.T('msg.operationFailed')), !!r.ok);
      if (r.ok) setTimeout(function () { window.location.reload(); }, 1200);
    });
  }
})();
</script>
