<section class="section">
  <div class="container">
    <div class="section__head">
      <div><div class="eyebrow"><%= t('nav.panel') %></div><h1><%= t('admin.trains') %></h1><p><%= total %> <%= t('admin.trainCountSuffix') %></p></div>
      <div class="flex">
        <a href="/<%= locale %>/admin/qatarlar/yeni" class="btn btn--sm btn--primary"><%= t('admin.newTrainBtn') %></a>
        <a href="?line=all" class="btn btn--sm <%= line === 'all' ? 'btn--primary' : 'btn--outline' %>"><%= t('admin.paymentsFilterAll') %></a>
        <a href="?line=absheron" class="btn btn--sm <%= line === 'absheron' ? 'btn--primary' : 'btn--outline' %>"><%= t('line.absheronShort') %></a>
        <a href="?line=domestic" class="btn btn--sm <%= line === 'domestic' ? 'btn--primary' : 'btn--outline' %>"><%= t('home.domestic') %></a>
        <a href="?line=georgia" class="btn btn--sm <%= line === 'georgia' ? 'btn--primary' : 'btn--outline' %>"><%= t('line.georgiaShort') %></a>
        <a href="?line=international" class="btn btn--sm <%= line === 'international' ? 'btn--primary' : 'btn--outline' %>"><%= t('home.international') %></a>
      </div>
    </div>

    <div class="layout-aside">
      <%- include('../../partials/admin-nav') %>

      <div>
        <div class="table-wrap">
          <table class="data">
            <thead>
              <tr><th><%= t('table.number') %></th><th>Ad</th><th><%= t('timetable.line') %></th><th><%= t('table.route') %></th><th><%= t('table.classes') %></th><th><%= t('admin.colDays') %></th><th><%= t('account.status') %></th><th></th></tr>
            </thead>
            <tbody>
              <% trains.forEach(function(tr){ %>
                <tr>
                  <td class="num"><strong><%= tr.number %></strong></td>
                  <td><%= tr.title %></td>
                  <td><span class="badge badge--blue"><%= tr.line %></span></td>
                  <td><%= (tr.stops[0] || {}).name %> — <%= (tr.stops[tr.stops.length - 1] || {}).name %></td>
                  <td>
                    <% tr.classes.forEach(function(c){ %>
                      <span class="chip"><%= c.title %> · <%= c.price.toFixed(2) %> ₼</span>
                    <% }) %>
                  </td>
                  <td class="sec-note">
                    <%= (tr.weekdays || []).join(',') %><br />
                    <%= tr.validFrom || '…' %> → <%= tr.validUntil || '…' %>
                    <% if (tr.advanceSaleUntil) { %><br />Satış: <%= tr.advanceSaleUntil %>-dək<% } %>
                  </td>
                  <td><span class="badge <%= tr.active ? 'badge--blue' : 'badge--red' %>"><%= tr.active ? t('common.active') : t('common.inactive') %></span></td>
                  <td>
                    <a href="/<%= locale %>/admin/qatarlar/<%= tr._id %>/redakte" class="btn btn--sm btn--outline"><%= t('common.edit') %></a>
                    <button type="button" class="btn btn--sm btn--outline" data-train-toggle="<%= tr._id %>"><%= tr.active ? t('admin.deactivate') : t('admin.activate') %></button>
                    <% if (tr.source === 'admin') { %><button type="button" class="btn btn--sm btn--outline" data-train-delete="<%= tr._id %>"><%= t('common.delete') %></button><% } %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
(function () {
  document.querySelectorAll('[data-train-toggle]').forEach(function (b) {
    b.addEventListener('click', async function () {
      var r = await window.api('/api/admin/trains/' + b.getAttribute('data-train-toggle') + '/toggle', {});
      if (window.toast) window.toast(r.message || (r.ok ? window.T('admin.completed') : window.T('msg.operationFailed')), r.ok ? 'success' : 'error');
      if (r.ok) setTimeout(function () { window.location.reload(); }, 600);
    });
  });
  document.querySelectorAll('[data-train-delete]').forEach(function (b) {
    b.addEventListener('click', async function () {
      if (!window.confirm(window.T('admin.confirmDeleteTrain'))) return;
      var r = await window.api('/api/admin/trains/' + b.getAttribute('data-train-delete'), {}, 'DELETE');
      if (window.toast) window.toast(r.message || (r.ok ? window.T('admin.deleted') : window.T('msg.operationFailed')), r.ok ? 'success' : 'error');
      if (r.ok) setTimeout(function () { window.location.reload(); }, 600);
    });
  });
})();
</script>
