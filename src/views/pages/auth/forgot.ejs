<div class="auth-wrap">
  <aside class="auth-aside">
    <h2>Şifrənin bərpası</h2>
    <p style="color:#cfe0f0">E-poçt ünvanınızı daxil edin, bərpa linki göndərəcəyik.</p>
  </aside>

  <div class="auth-main">
    <div class="auth-box">
      <h1 style="font-size:1.6rem">Şifrəni bərpa et</h1>
      <p style="color:var(--ink-2)">Qeydiyyat zamanı istifadə etdiyiniz e-poçtu daxil edin.</p>

      <div class="alert alert--success" id="okBox" style="display:none"></div>
      <div class="alert alert--error" id="errBox" style="display:none"></div>

      <form id="forgotForm">
        <div class="field">
          <label>E-poçt</label>
          <input type="email" name="email" placeholder="ad@salam.com" required />
        </div>
        <button type="submit" class="btn btn--primary btn--block btn--lg" id="forgotBtn">Bərpa linki göndər</button>
      </form>

      <p style="text-align:center;margin-top:20px;font-size:.9rem">
        <a href="/<%= locale %>/login">← Daxil olma səhifəsinə qayıt</a>
      </p>
    </div>
  </div>
</div>

<script>
  (function () {
    var form = document.getElementById('forgotForm');
    var btn = document.getElementById('forgotBtn');

    form.addEventListener('submit', async function (e) {
      e.preventDefault();
      window.setLoading(btn, true);
      var r = await window.api('/api/auth/forgot-password', { email: form.querySelector('[name=email]').value });
      window.setLoading(btn, false);
      var ok = document.getElementById('okBox');
      var er = document.getElementById('errBox');
      ok.style.display = 'none'; er.style.display = 'none';
      if (r.ok) {
        ok.textContent = r.message;
        ok.style.display = 'block';
        form.reset();
      } else {
        er.textContent = r.message || 'Xəta baş verdi';
        er.style.display = 'block';
      }
    });
  })();
</script>
