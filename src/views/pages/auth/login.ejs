<section class="section">
  <div class="container-fluid">
    <div style="max-width:520px;margin:0 auto">
      <div class="card">
        <div class="card__body">
          <div class="ady-eyebrow"><%= t('nav.login') %></div>
          <h1 style="font-size:1.5rem"><%= t('nav.login') %></h1>
          <p class="sec-note mb-24"><%= t('auth.loginHint') %></p>

          <div id="formNote" class="hidden mb-16"></div>

          <div class="ady-tabs" style="margin-bottom:16px">
            <button type="button" class="ady-tab is-active" data-tab="emailTab" data-tab-group="loginMode"><%= t('auth.tabEmail') %></button>
            <button type="button" class="ady-tab" data-tab="phoneTab" data-tab-group="loginMode"><%= t('checkout.phone') %></button>
          </div>

          <div data-panel="emailTab" data-panel-group="loginMode" class="ady-panel is-active">
            <form id="loginForm" autocomplete="on">
              <div class="field">
                <label for="email"><%= t('auth.emailFieldLabel') %></label>
                <input type="email" id="email" name="email" required autocomplete="username" />
              </div>
              <div class="field">
                <label for="password"><%= t('auth.passwordFieldLabel') %></label>
                <input type="password" id="password" name="password" required autocomplete="current-password" />
              </div>
              <div class="field">
                <a href="/<%= locale %>/sifre-berpasi" class="text-sm"><%= t('auth.forgotShort') %></a>
              </div>
              <button type="submit" class="btn btn-blue btn--block btn--lg"><%= t('nav.login') %></button>
            </form>

            <p class="text-sm text-center mt-24 mb-0">
              <%= t('auth.noAccount') %> <a href="/<%= locale %>/qeydiyyat"><%= t('nav.register') %></a>
            </p>
          </div>

          <div data-panel="phoneTab" data-panel-group="loginMode" class="ady-panel">
            <form id="phoneLoginForm" autocomplete="on">
              <div class="field">
                <label for="phone"><%= t('checkout.phone') %></label>
                <input type="tel" id="phone" name="phone" placeholder="+994" required />
              </div>
              <div class="field">
                <label for="phonePassword"><%= t('auth.passwordFieldLabel') %></label>
                <input type="password" id="phonePassword" name="password" required autocomplete="current-password" />
              </div>
              <button type="submit" class="btn btn-blue btn--block btn--lg"><%= t('nav.login') %></button>
            </form>
          </div>

          <p class="text-sm text-center mt-24 mb-0">
            <a href="/<%= locale %>/bilet-axtar">Bilet almaq üçün giriş tələb olunmur — davam et</a>
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  (function () {
    var phoneForm = document.getElementById('phoneLoginForm');
    if (!phoneForm) return;
    phoneForm.addEventListener('submit', async function (e) {
      e.preventDefault();
      var note = document.getElementById('formNote');
      var btn = phoneForm.querySelector('button[type=submit]');
      window.setLoading(btn, true);
      var r = await window.api('/api/auth/login', {
        phone: phoneForm.querySelector('[name=phone]').value,
        password: phoneForm.querySelector('[name=password]').value
      });
      window.setLoading(btn, false);
      if (r.ok) { window.location.href = r.redirect || '/'; return; }
      note.className = 'alert alert--error mb-16';
      note.textContent = r.message || 'Giriş alınmadı';
    });
  })();
</script>
