<section class="section">
  <div class="container">
    <div style="max-width:520px;margin:0 auto">
      <div class="card">
        <div class="card__body">
          <div class="eyebrow">Daxil ol</div>
          <h1 style="font-size:1.5rem">Daxil ol</h1>
          <p class="sec-note mb-24">Hesabınıza həm e-mail həm də mobil nömrə vasitəsi ilə daxil ola bilərsiniz.</p>

          <div id="formNote" class="hidden mb-16"></div>

          <div class="timetable-tabs" style="margin-bottom:16px">
            <button type="button" class="tab is-active" data-tab="emailTab" data-tab-group="loginMode">E-mail</button>
            <button type="button" class="tab" data-tab="phoneTab" data-tab-group="loginMode">Telefon</button>
          </div>

          <div data-panel="emailTab" data-panel-group="loginMode" class="is-active">
            <form id="loginForm" autocomplete="on">
              <div class="field">
                <label for="email">Elektron poçt</label>
                <input type="email" id="email" name="email" required autocomplete="username" />
              </div>
              <div class="field">
                <label for="password">Şifrə</label>
                <input type="password" id="password" name="password" required autocomplete="current-password" />
              </div>
              <div class="field">
                <a href="/<%= locale %>/sifre-berpasi" class="text-sm">Şifrəni unutdum</a>
              </div>
              <button type="submit" class="btn btn--primary btn--block btn--lg">Daxil ol</button>
            </form>

            <p class="text-sm text-center mt-24 mb-0">
              Hesabınız yoxdur? <a href="/<%= locale %>/qeydiyyat">Qeydiyyat</a>
            </p>
          </div>

          <div data-panel="phoneTab" data-panel-group="loginMode">
            <form id="phoneLoginForm" autocomplete="on">
              <div class="field">
                <label for="phone">Telefon</label>
                <input type="tel" id="phone" name="phone" placeholder="+994" required />
              </div>
              <div class="field">
                <label for="phonePassword">Şifrə</label>
                <input type="password" id="phonePassword" name="password" required autocomplete="current-password" />
              </div>
              <div class="field">
                <a href="/<%= locale %>/sifre-berpasi" class="text-sm">Şifrəni unutdum</a>
              </div>
              <button type="submit" class="btn btn--primary btn--block btn--lg">Daxil ol</button>
            </form>

            <p class="text-sm text-center mt-24 mb-0">
              Hesabınız yoxdur? <a href="/<%= locale %>/qeydiyyat">Qeydiyyat</a>
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  (function () {
    var phoneForm = document.getElementById('phoneLoginForm');
    if (!phoneForm) return;
    phoneForm.addEventListener('submit', async function (e) {
      e.preventDefault();
      var note = document.getElementById('formNote');
      var btn = phoneForm.querySelector('button[type=submit]');
      window.setLoading(btn, true);
      var payload = {
        phone: phoneForm.querySelector('[name=phone]').value,
        password: phoneForm.querySelector('[name=password]').value
      };
      var r = await window.api('/api/auth/login', payload);
      window.setLoading(btn, false);
      if (r.ok) { window.location.href = r.redirect || '/'; return; }
      note.className = 'alert alert--error mb-16';
      note.textContent = r.message || 'Giriş alınmadı';
    });
  })();
</script>
