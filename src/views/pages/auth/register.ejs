<section class="section">
  <div class="container">
    <div style="max-width:620px;margin:0 auto">
      <div class="card">
        <div class="card__body">
          <div class="eyebrow">Qeydiyyat</div>
          <h1 style="font-size:1.5rem">Qeydiyyat</h1>
          <p class="sec-note mb-24">Hesabınıza həm e-mail həm də mobil nömrə vasitəsi ilə daxil ola bilərsiniz.</p>

          <div id="formNote" class="hidden mb-16"></div>

          <form id="registerForm" autocomplete="on">
            <div class="field">
              <label for="firstName">Ad</label>
              <input type="text" id="firstName" name="firstName" required />
            </div>
            <div class="field">
              <label for="lastName">Soyad</label>
              <input type="text" id="lastName" name="lastName" required />
            </div>
            <div class="field">
              <label for="email">Elektron poçt</label>
              <input type="email" id="email" name="email" required autocomplete="email" />
            </div>
            <div class="field">
              <label for="password">Şifrə</label>
              <input type="password" id="password" name="password" required autocomplete="new-password" minlength="6" />
            </div>
            <div class="field">
              <label for="passwordRepeat">Şifrəni təkrarlayın</label>
              <input type="password" id="passwordRepeat" name="passwordRepeat" required minlength="6" />
            </div>
            <div class="field">
              <label for="phone">Telefon</label>
              <input type="tel" id="phone" name="phone" placeholder="+994" />
            </div>

            <div class="field">
              <label class="checkbox">
                <input type="checkbox" name="agree" required />
                <span>Qeydiyyatdan keçərək siz istifadəçi <a href="/<%= locale %>/mexfilik-siyaseti" target="_blank" rel="noopener">şərtləri ilə</a> razısız</span>
              </label>
            </div>

            <button type="submit" class="btn btn--primary btn--block btn--lg">Qeydiyyatdan keç</button>
          </form>

          <p class="text-sm text-center mt-24 mb-0">
            <a href="/<%= locale %>/login">Daxil ol</a>
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
