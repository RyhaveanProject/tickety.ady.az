<div class="auth-wrap">
  <aside class="auth-aside">
    <h2>Yeni şifrə təyin et</h2>
    <p style="color:#cfe0f0">Təhlükəsiz şifrə seçin — ən azı 6 simvol.</p>
  </aside>

  <div class="auth-main">
    <div class="auth-box">
      <h1 style="font-size:1.6rem">Yeni şifrə</h1>
      <div class="alert alert--error" id="errBox" style="display:none"></div>

      <form id="resetForm">
        <div class="field">
          <label>Yeni şifrə</label>
          <input type="password" name="password" required minlength="6" />
        </div>
        <div class="field">
          <label>Yeni şifrənin təkrarı</label>
          <input type="password" name="passwordConfirm" required minlength="6" />
        </div>
        <button type="submit" class="btn btn--primary btn--block btn--lg" id="resetBtn">Şifrəni yenilə</button>
      </form>
    </div>
  </div>
</div>

<script>
  (function () {
    var form = document.getElementById('resetForm');
    var btn = document.getElementById('resetBtn');
    form.addEventListener('submit', async function (e) {
      e.preventDefault();
      window.setLoading(btn, true);
      var r = await window.api('/api/auth/reset-password', {
        token: '<%= token %>',
        password: form.querySelector('[name=password]').value,
        passwordConfirm: form.querySelector('[name=passwordConfirm]').value
      });
      window.setLoading(btn, false);
      if (r.ok) window.location.href = r.redirect;
      else {
        var er = document.getElementById('errBox');
        er.textContent = r.message || 'Xəta';
        er.style.display = 'block';
      }
    });
  })();
</script>
