<section class="section">
  <div class="container">
    <div class="section__head">
      <div>
        <div class="eyebrow"><%= trip.trainNumber %> · <%= trip.date %></div>
        <h1><%= t('checkout.title') %></h1>
        <p><%= t('checkout.sub') %></p>
      </div>
      <a href="/<%= locale %>/yer-secimi/<%= trip._id %>?from=<%= from %>&to=<%= to %>&passengers=<%= seats.length %>" class="btn btn--outline"><%= t('seats.back') %></a>
    </div>

    <div class="layout-aside">
      <div>
        <div class="card mb-16"><div class="card__body">
          <h3 style="font-size:1rem"><%= t('table.route') %></h3>
          <dl class="kv">
            <dt><%= t('results.train') %></dt><dd><%= trip.trainNumber %> · <%= trip.trainTitle %></dd>
            <dt><%= t('common.date') %></dt><dd><%= trip.date %></dd>
            <dt><%= t('search.from') %></dt><dd><%= fromName %></dd>
            <dt><%= t('search.to') %></dt><dd><%= toName %></dd>
          </dl>
        </div></div>

        <div class="card"><div class="card__body">
          <!-- ✅ FİX: formNote element'i görmə olmağı təmin et -->
          <div id="formNote" class="hidden"></div>

          <h3 style="font-size:1rem"><%= t('checkout.contact') %></h3>
          <div class="field--row">
            <div class="field">
              <label for="contactPhone"><%= t('checkout.phone') %></label>
              <!-- ✅ FİX: name attribute'ı əlavə edildi -->
              <input type="tel" id="contactPhone" name="contactPhone" value="<%= user.phone || '' %>" required />
            </div>
            <div class="field">
              <label for="contactEmail"><%= t('checkout.email') %></label>
              <!-- ✅ FİX: name attribute'ı əlavə edildi -->
              <input type="email" id="contactEmail" name="contactEmail" value="<%= user.email %>" required />
            </div>
          </div>

          <% seats.forEach(function(s, i){ %>
            <hr />
            <h3 style="font-size:1rem"><%= t('checkout.passenger') %> <%= i + 1 %> <span class="badge badge--blue"><%= t('seats.wagon') %> <%= s.wagon %> · <%= s.seat %></span></h3>
            <div class="field--row">
              <div class="field">
                <label><%= t('checkout.lastName') %></label>
                <input type="text" data-p-lastname="<%= i %>" value="<%= i === 0 ? user.lastName : '' %>" required />
              </div>
              <div class="field">
                <label><%= t('checkout.firstName') %></label>
                <input type="text" data-p-firstname="<%= i %>" value="<%= i === 0 ? user.firstName : '' %>" required />
              </div>
            </div>
            <div class="field--row">
              <div class="field">
                <label><%= t('checkout.middleName') %></label>
                <input type="text" data-p-middlename="<%= i %>" value="<%= i === 0 ? (user.middleName || '') : '' %>" />
              </div>
              <div class="field">
                <label><%= t('checkout.birthDate') %></label>
                <input type="date" data-p-birthdate="<%= i %>" required />
              </div>
            </div>
            <div class="field--row">
              <div class="field">
                <label><%= t('checkout.docType') %></label>
                <select data-p-doctype="<%= i %>" required>
                  <option value="id"><%= t('checkout.docId') %></option>
                  <option value="passport"><%= t('checkout.docPassport') %></option>
                </select>
              </div>
              <div class="field">
                <label><%= t('checkout.docNumber') %></label>
                <input type="text" data-p-docnumber="<%= i %>" required />
              </div>
            </div>
          <% }) %>
        </div></div>
      </div>

      <div class="summary">
        <div class="card"><div class="card__body">
          <h3 style="font-size:1rem"><%= t('checkout.summary') %></h3>
          <% seats.forEach(function(s){ %>
            <div class="summary__row">
              <span><%= t('seats.wagon') %> <%= s.wagon %> · <%= s.seat %> — <%= s.className %></span>
              <span class="mono"><%= s.price.toFixed(2) %> ₼</span>
            </div>
          <% }) %>
          <div class="summary__row">
            <span><%= t('checkout.serviceFee') %></span>
            <span class="mono">0.00 ₼</span>
          </div>
          <div class="summary__total">
            <span><%= t('checkout.total') %></span>
            <span class="mono"><%= total.toFixed(2) %> ₼</span>
          </div>
          <button type="button" class="btn btn--primary btn--block btn--lg mt-16" id="toPayment"><%= t('checkout.next') %></button>
        </div></div>
      </div>
    </div>
  </div>
</section>

<!-- ✅ FİXLƏNMİŞ CHECKOUT SCRIPT -->
<script>
  document.getElementById('toPayment').addEventListener('click', async function () {
    var btn = this;
    var note = document.getElementById('formNote');
    var seats = <%- JSON.stringify(seats.map(function(s){ return { wagon: s.wagon, seat: s.seat, classCode: s.classCode }; })) %>;
    var passengers = [];

    // ✅ FİX 1: Validation error göstərilmə
    function showError(message) {
      if (!note) return;
      note.classList.remove('hidden');
      note.className = 'alert alert--error mb-16';
      note.textContent = message;
      window.toast(message, 'error');
    }

    // ✅ FİX 2: Form validasiyası əlavə edildi
    var contactPhone = document.getElementById('contactPhone');
    var contactEmail = document.getElementById('contactEmail');
    
    if (!contactPhone || !contactPhone.value.trim()) {
      showError('Əlaqə telefonu vacibdir');
      return;
    }
    if (!contactEmail || !contactEmail.value.trim()) {
      showError('Əlaqə e-poçtu vacibdir');
      return;
    }

    // ✅ FİX 3: Sərnişin validasiyası
    for (var i = 0; i < seats.length; i += 1) {
      var fn = document.querySelector('[data-p-firstname="' + i + '"]');
      var ln = document.querySelector('[data-p-lastname="' + i + '"]');
      var bd = document.querySelector('[data-p-birthdate="' + i + '"]');
      var dn = document.querySelector('[data-p-docnumber="' + i + '"]');

      if (!fn || !fn.value.trim()) {
        showError('Sərnişin ' + (i + 1) + ': Adı daxil edin');
        return;
      }
      if (!ln || !ln.value.trim()) {
        showError('Sərnişin ' + (i + 1) + ': Soyadı daxil edin');
        return;
      }
      if (!bd || !bd.value) {
        showError('Sərnişin ' + (i + 1) + ': Doğum tarixini seçin');
        return;
      }
      if (!dn || !dn.value.trim()) {
        showError('Sərnişin ' + (i + 1) + ': Sənəd nömrəsini daxil edin');
        return;
      }

      passengers.push({
        firstName: fn.value.trim(),
        lastName: ln.value.trim(),
        middleName: (document.querySelector('[data-p-middlename="' + i + '"]') || {}).value || '',
        birthDate: bd.value,
        docType: (document.querySelector('[data-p-doctype="' + i + '"]') || {}).value || 'id',
        docNumber: dn.value.trim(),
        wagon: seats[i].wagon,
        seat: seats[i].seat,
        classCode: seats[i].classCode
      });
    }

    window.setLoading(btn, true);
    try {
      var r = await window.api('/api/booking/order', {
        tripId: '<%= trip._id %>',
        fromCode: '<%= from %>',
        toCode: '<%= to %>',
        passengers: passengers,
        contactPhone: contactPhone.value.trim(),
        contactEmail: contactEmail.value.trim()
      });
      
      window.setLoading(btn, false);

      if (r.ok) {
        if (!note) return;
        note.classList.add('hidden');
        window.toast(r.message || 'Sifariş yaradıldı', 'success');
        // Sifariş yaradıldıqdan sonra ödəniş səhifəsinə yönləndirin
        setTimeout(function () {
          window.location.href = r.redirect;
        }, 500);
      } else {
        // ✅ FİX 4: Error göstərişi
        showError(r.message || 'Sifariş yaradıla bilmədi');
      }
    } catch (err) {
      window.setLoading(btn, false);
      showError(err.message || 'Bilinməyən xəta baş verdi');
      console.error('Checkout error:', err);
    }
  });
</script>
