<div class="page-head">
  <div class="container">
    <div class="breadcrumb"><a href="/<%= locale %>">Ana səhifə</a> <span>/</span> <span>Sərnişin məlumatları</span></div>
    <h1>Sərnişin məlumatları</h1>
    <p style="color:var(--ink-2);margin:0"><%= fromName %> → <%= toName %> · <%= trip.date %> · <%= seats.length %> bilet</p>
  </div>
</div>

<section class="section">
  <div class="container">
    <div class="steps">
      <div class="step is-done"><span class="step__num">✓</span> Reys seçimi</div>
      <div class="step is-done"><span class="step__num">✓</span> Yer seçimi</div>
      <div class="step is-active"><span class="step__num">3</span> Sərnişin məlumatları</div>
      <div class="step"><span class="step__num">4</span> Ödəniş</div>
    </div>

    <div class="two-col">
      <div>
        <div class="alert alert--info">
          Bilet alanın və sərnişinlərin məlumatları gediş sənədinə uyğun olmalıdır. Sənəd nömrəsi olmadan bilet etibarsız sayılır.
        </div>

        <form id="checkoutForm">
          <% seats.forEach(function(s, i){ %>
            <div class="passenger-card">
              <div class="passenger-card__head">
                <span>Sərnişin <%= i + 1 %></span>
                <span class="badge badge--blue"><%= s.classCode %> · Vaqon <%= s.wagon %> · Yer <%= s.seat %></span>
              </div>
              <div class="form-row">
                <div class="field" data-field>
                  <label>Ad *</label>
                  <input type="text" name="firstName_<%= i %>" required />
                  <div class="field__error">Adı daxil edin</div>
                </div>
                <div class="field" data-field>
                  <label>Soyad *</label>
                  <input type="text" name="lastName_<%= i %>" required />
                  <div class="field__error">Soyadı daxil edin</div>
                </div>
              </div>
              <div class="form-row">
                <div class="field" data-field>
                  <label>Sənədin növü *</label>
                  <select name="docType_<%= i %>">
                    <option value="fin">FİN kod</option>
                    <option value="id">Şəxsiyyət vəsiqəsi</option>
                    <option value="passport">Xarici pasport</option>
                    <option value="birth">Doğum şəhadətnaməsi</option>
                  </select>
                </div>
                <div class="field" data-field>
                  <label>Sənədin nömrəsi *</label>
                  <input type="text" name="docNumber_<%= i %>" required />
                  <div class="field__error">Sənəd nömrəsini daxil edin</div>
                </div>
              </div>
              <div class="form-row">
                <div class="field">
                  <label>Doğum tarixi</label>
                  <input type="date" name="birthDate_<%= i %>" />
                </div>
                <div class="field">
                  <label>Qiymət</label>
                  <input type="text" value="<%= Number(s.price).toFixed(2) %> ₼" disabled />
                </div>
              </div>
            </div>
          <% }) %>

          <div class="card" style="margin-top:8px">
            <div class="card__head">Əlaqə məlumatları</div>
            <div class="card__body">
              <div class="form-row">
                <div class="field" data-field>
                  <label>Telefon *</label>
                  <input type="tel" name="contactPhone" placeholder="+994501234567" value="<%= user ? user.phone : '' %>" required />
                  <div class="field__error">Telefon nömrəsini daxil edin</div>
                </div>
                <div class="field" data-field>
                  <label>E-poçt *</label>
                  <input type="email" name="contactEmail" value="<%= user ? user.email : '' %>" required />
                  <div class="field__error">E-poçtu daxil edin</div>
                </div>
              </div>
              <label class="checkbox">
                <input type="checkbox" id="agreeTerms" required />
                <span>Mən <a href="/<%= locale %>/dasima-qaydalari" target="_blank">daşıma qaydaları</a> və <a href="/<%= locale %>/tarifler-ve-odenis/elektron-bilet" target="_blank">elektron bilet satışı qaydaları</a> ilə tanış oldum və qəbul edirəm.</span>
              </label>
            </div>
          </div>
        </form>
      </div>

      <div>
        <div class="card order-summary">
          <div class="card__head">Sifarişin xülasəsi</div>
          <div class="card__body">
            <div class="summary-row"><span>Qatar</span><strong><%= trip.trainNumber %> · <%= trip.trainTitle %></strong></div>
            <div class="summary-row"><span>Marşrut</span><strong><%= fromName %> → <%= toName %></strong></div>
            <div class="summary-row"><span>Tarix</span><strong><%= trip.date %></strong></div>
            <div class="summary-row"><span>Yola düşmə</span><strong><%= departTime %></strong></div>
            <div class="summary-row"><span>Çatma</span><strong><%= arriveTime %></strong></div>
            <div class="summary-row"><span>Yolda</span><strong><%= durationText %></strong></div>

            <div style="margin:16px 0">
              <% seats.forEach(function(s){ %>
                <div class="summary-row">
                  <span>Vaqon <%= s.wagon %> · Yer <%= s.seat %></span>
                  <strong><%= Number(s.price).toFixed(2) %> ₼</strong>
                </div>
              <% }) %>
            </div>

            <div class="summary-row summary-row--total">
              <span>Ümumi</span>
              <span><%= Number(total).toFixed(2) %> ₼</span>
            </div>

            <button type="button" class="btn btn--primary btn--block btn--lg" id="payBtn" style="margin-top:16px">
              Ödənişə keç
            </button>

            <% if (!user) { %>
              <div class="alert alert--warn" style="margin-top:14px">
                Bilet almaq üçün <a href="/<%= locale %>/login?next=<%= encodeURIComponent(currentUrl) %>"><strong>hesabınıza daxil olun</strong></a> və ya <a href="/<%= locale %>/qeydiyyat"><strong>qeydiyyatdan keçin</strong></a>.
              </div>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  (function () {
    var btn = document.getElementById('payBtn');
    var form = document.getElementById('checkoutForm');
    var seatCount = Number('<%= seats.length %>');

    btn.addEventListener('click', async function () {
      // Validasiya
      var invalid = false;
      form.querySelectorAll('[data-field] input[required]').forEach(function (inp) {
        var wrap = inp.closest('[data-field]');
        if (!inp.value.trim()) { wrap.classList.add('field--error'); invalid = true; }
        else wrap.classList.remove('field--error');
      });
      if (!document.getElementById('agreeTerms').checked) {
        window.toast('Qaydalarla razılaşmalısınız', 'error');
        return;
      }
      if (invalid) { window.toast('Zəruri xanaları doldurun', 'error'); return; }

      var passengers = [];
      for (var i = 0; i < seatCount; i++) {
        passengers.push({
          firstName: form.querySelector('[name=firstName_' + i + ']').value.trim(),
          lastName: form.querySelector('[name=lastName_' + i + ']').value.trim(),
          docType: form.querySelector('[name=docType_' + i + ']').value,
          docNumber: form.querySelector('[name=docNumber_' + i + ']').value.trim(),
          birthDate: form.querySelector('[name=birthDate_' + i + ']').value || undefined,
          wagon: Number('<%= seats[0] ? seats[0].wagon : 1 %>') // override below
        });
      }
      var seatMeta = <%- JSON.stringify(seats) %>;
      passengers.forEach(function (p, i) {
        p.wagon = Number(seatMeta[i].wagon);
        p.seat = seatMeta[i].seat;
        p.classCode = seatMeta[i].classCode;
        p.price = Number(seatMeta[i].price);
      });

      var payload = {
        tripId: '<%= trip._id %>',
        from: '<%= from %>',
        to: '<%= to %>',
        passengers: passengers,
        contact: {
          phone: form.querySelector('[name=contactPhone]').value.trim(),
          email: form.querySelector('[name=contactEmail]').value.trim()
        }
      };

      window.setLoading(btn, true);
      var r = await window.api('/api/booking/order', payload);
      window.setLoading(btn, false);

      if (r.ok) {
        window.location.href = r.redirect;
      } else if (r.error === 'auth_required') {
        window.location.href = r.redirect || ('/<%= locale %>/login');
      } else {
        window.toast(r.message || 'Sifariş yaradıla bilmədi', 'error');
      }
    });
  })();
</script>
