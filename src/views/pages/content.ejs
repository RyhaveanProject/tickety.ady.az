<div class="page-head">
  <div class="container">
    <div class="breadcrumb"><a href="/<%= locale %>">Ana səhifə</a> <span>/</span> <span><%= page.title %></span></div>
    <h1><%= page.title %></h1>
    <% if (page.excerpt) { %><p style="color:var(--ink-2);margin:0"><%= page.excerpt %></p><% } %>
  </div>
</div>

<section class="section">
  <div class="container" style="max-width:920px">
    <div class="card">
      <div class="card__body prose">
        <% if (page.image) { %><img src="<%= page.image %>" alt="<%= page.title %>" /><% } %>
        <%- page.content %>
      </div>
    </div>
  </div>
</section>
