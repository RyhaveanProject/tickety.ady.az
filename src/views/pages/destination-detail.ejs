<div class="page-head">
  <div class="container">
    <div class="breadcrumb">
      <a href="/<%= locale %>">Ana səhifə</a> <span>/</span>
      <a href="/<%= locale %>/populyar-istiqametler">Populyar istiqamətlər</a> <span>/</span> <span><%= item.title %></span>
    </div>
    <h1><%= item.title %></h1>
    <p style="color:var(--ink-2);margin:0"><%= item.summary %></p>
  </div>
</div>

<section class="section">
  <div class="container">
    <div class="two-col">
      <div class="prose">
        <% if (item.image) { %><img src="<%= item.image %>" alt="<%= item.title %>" /><% } %>
        <%- item.content %>
      </div>
      <div>
        <div class="card order-summary">
          <div class="card__head">Bilet al</div>
          <div class="card__body">
            <% if (item.priceFrom) { %>
              <div style="font-size:1.5rem;font-weight:700;color:var(--ady-blue);margin-bottom:14px">
                <%= item.priceFrom.toFixed(2) %> ₼-dən
              </div>
            <% } %>
            <a href="/<%= locale %>/reysler?from=BAK&to=<%= item.stationCode %>&date=<%= new Date().toISOString().slice(0,10) %>&passengers=1" class="btn btn--primary btn--block">
              Bu istiqamətə bilet al
            </a>
            <a href="/<%= locale %>/hereket-cedveli" class="btn btn--ghost btn--block" style="margin-top:10px">Hərəkət cədvəli</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
