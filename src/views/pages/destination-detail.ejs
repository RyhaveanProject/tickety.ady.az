<section class="section">
  <div class="container">
    <div class="page-banner">
      <img src="<%= destination.image %>" alt="<%= destination.title %>" />
    </div>

    <div class="section__head">
      <div>
        <div class="eyebrow"><%= t('nav.destinations') %></div>
        <h1><%= destination.title %> <%= t('dest.trainTicket') %></h1>
        <div class="feature__meta" style="margin-top:8px">
          <span><strong><%= destination.priceFrom.toFixed(2) %></strong> <%= t('home.aznFrom') %></span>
          <span><%= destination.durationText %></span>
          <span><%= destination.distanceKm %> km</span>
        </div>
      </div>
      <a href="/<%= locale %>/bilet-axtar?to=<%= destination.stationCode %>" class="btn btn--primary"><%= t('home.buyTicket') %></a>
    </div>

    <div class="grid grid--3">
      <div style="grid-column:span 2">
        <div class="card mb-16"><div class="card__body content-body">
          <%- destination.content || ('<p>' + destination.summary + '</p>') %>
        </div></div>

        <div class="card">
          <div class="card__head"><span><%= t('nav.timetable') %> — <%= today %></span></div>
          <div class="card__body">
            <% if (!departures.length) { %>
              <p class="sec-note mb-0"><%= t('results.none') %></p>
            <% } else { %>
              <div class="table-wrap"><table class="data">
                <thead><tr><th><%= t('table.train') %></th><th><%= t('table.route') %></th><th><%= t('table.depart') %></th><th><%= t('table.price') %></th><th></th></tr></thead>
                <tbody>
                  <% departures.forEach(function(r){ %>
                    <tr>
                      <td class="num"><strong><%= r.number %></strong></td>
                      <td><%= r.from %> — <%= r.to %></td>
                      <td class="num"><%= r.depart %></td>
                      <td class="num"><%= r.minPrice.toFixed(2) %> ₼</td>
                      <td><a href="/<%= locale %>/reysler?from=<%= r.fromCode %>&to=<%= r.toCode %>&date=<%= today %>&passengers=1" class="btn btn--sm btn--primary"><%= t('home.buyTicket') %></a></td>
                    </tr>
                  <% }) %>
                </tbody>
              </table></div>
            <% } %>
          </div>
        </div>
      </div>

      <div class="summary">
        <div class="card mb-16"><div class="card__body">
          <h3 style="font-size:1rem"><%= t('dest.panelTitle') %></h3>
          <% if (station) { %>
            <dl class="kv mb-16">
              <dt><%= t('home.statStations') %></dt><dd><%= station.name %></dd>
              <dt><%= t('common.code') %></dt><dd class="mono"><%= station.code %></dd>
              <dt><%= t('common.region') %></dt><dd><%= station.region %></dd>
            </dl>
          <% } %>
          <a href="/<%= locale %>/bilet-axtar?to=<%= destination.stationCode %>" class="btn btn--primary btn--block"><%= t('home.buyTicket') %></a>
        </div></div>

        <div class="card"><div class="card__body">
          <h3 style="font-size:1rem"><%= t('dest.other') %></h3>
          <div class="admin-nav">
            <% others.forEach(function(o){ %>
              <a href="/<%= locale %>/populyar-istiqametler/<%= o.slug %>">
                <span><%= o.title %></span><small><%= o.priceFrom.toFixed(2) %> ₼</small>
              </a>
            <% }) %>
          </div>
        </div></div>
      </div>
    </div>
  </div>
</section>
