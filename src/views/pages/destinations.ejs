<section class="section">
  <div class="container">
    <div class="page-banner">
      <img src="/assets/ady/banner-2.svg" alt="<%= t('nav.destinations') %>" />
    </div>

    <div class="section__head">
      <div>
        <div class="eyebrow"><%= t('home.travel') %></div>
        <h1><%= subtitle || t('nav.destinations') %></h1>
        <p><%= t('home.popularSub') %></p>
      </div>
    </div>

    <div class="grid grid--3">
      <% destinations.forEach(function(d){ %>
        <a href="/<%= locale %>/populyar-istiqametler/<%= d.slug %>" class="feature">
          <div class="feature__img"><img src="<%= d.image %>" alt="<%= d.title %>" style="height:190px" /></div>
          <div class="feature__body">
            <h3><%= d.title %></h3>
            <div class="feature__meta">
              <span><strong><%= d.priceFrom.toFixed(2) %></strong> <%= t('home.aznFrom') %></span>
              <span><%= d.durationText %></span>
              <span><%= d.distanceKm %> km</span>
            </div>
            <p><%= d.summary %></p>
            <span class="feature__link"><%= t('home.readMore') %></span>
          </div>
        </a>
      <% }) %>
    </div>
  </div>
</section>
