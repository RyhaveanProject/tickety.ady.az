<div class="page-head">
  <div class="container">
    <div class="breadcrumb"><a href="/<%= locale %>">Ana səhifə</a> <span>/</span> <span>Populyar istiqamətlər</span></div>
    <h1>Populyar istiqamətlər</h1>
    <p style="color:var(--ink-2);margin:0">ADY ilə Azərbaycanı kəşf et</p>
  </div>
</div>

<section class="section">
  <div class="container">
    <% if (!items.length) { %>
      <div class="card"><div class="empty"><div class="empty__icon">🗺</div><p>Məlumat yoxdur.</p></div></div>
    <% } else { %>
      <div class="grid grid--3">
        <% items.forEach(function(d){ %>
          <a href="/<%= locale %>/populyar-istiqametler/<%= d.slug %>" class="feature">
            <% if (d.image) { %>
              <img src="<%= d.image %>" alt="<%= d.title %>" class="feature__img" loading="lazy" />
            <% } else { %>
              <div class="feature__img" style="display:grid;place-items:center;font-size:2rem">🏙</div>
            <% } %>
            <div class="feature__body">
              <h3><%= d.title %></h3>
              <p><%= d.summary %></p>
              <% if (d.priceFrom) { %>
                <div style="font-weight:700;color:var(--ady-blue);margin-bottom:8px"><%= d.priceFrom.toFixed(2) %> ₼-dən</div>
              <% } %>
              <span class="feature__link">Ətraflı oxu →</span>
            </div>
          </a>
        <% }) %>
      </div>
    <% } %>
  </div>
</section>
