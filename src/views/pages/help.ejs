<section class="section">
  <div class="container">
    <div class="section__head"><div><div class="eyebrow"><%= t('nav.help') %></div><h1><%= t('nav.help') %></h1></div></div>

    <div class="grid grid--3">
      <div style="grid-column:span 2">
        <h2 style="font-size:1.15rem"><%= t('home.faq') %></h2>
        <% faqs.forEach(function(f){ %>
          <div class="faq mb-8">
            <div class="faq__q"><%= f.question %></div>
            <div class="faq__a"><%= f.answer %></div>
          </div>
        <% }) %>
      </div>

      <div class="summary">
        <div class="card mb-16"><div class="card__body">
          <h3 style="font-size:1rem"><%= t('nav.contact') %></h3>
          <dl class="kv">
            <dt><%= t('footer.callCenter') %></dt><dd><%= site.supportPhone %></dd>
            <dt><%= t('checkout.phone') %></dt><dd><%= site.supportPhoneLandline %></dd>
            <dt><%= t('common.email') %></dt><dd><%= site.supportEmail %></dd>
          </dl>
          <a href="/<%= locale %>/elaqe" class="btn btn--primary btn--block mt-16"><%= t('nav.contact') %></a>
        </div></div>

        <div class="card"><div class="card__body">
          <h3 style="font-size:1rem"><%= t('nav.rules') %></h3>
          <div class="admin-nav">
            <% pages.forEach(function(p){ %>
              <a href="/<%= locale %>/dasima-qaydalari/<%= p.slug %>"><span><%= p.title %></span></a>
            <% }) %>
          </div>
        </div></div>
      </div>
    </div>
  </div>
</section>
