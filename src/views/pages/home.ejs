<!-- ==================== Hero + bilet alma (əsas giriş bölməsi) ==================== -->
<section class="hero">
  <div class="hero__media">
    <img src="/ady-design/images/veb-sayt-banner-2.jpg"
         srcset="/ady-design/images/veb-sayt-banner-2.jpg 1x, /ady-design/images/veb-sayt-banner-2_1.jpg 2x"
         width="1920" alt="<%= t('home.heroTitle') %>" />
  </div>
  <div class="search">
    <div class="container-fluid">
      <div class="ady-search-card">
        <%- include('../partials/search-form', { stations: stations, today: serverDate, maxDate: serverDateMax, prefill: null }) %>
      </div>
    </div>
  </div>
</section>

<!-- ==================== Xidmət kartları (usefully) ==================== -->
