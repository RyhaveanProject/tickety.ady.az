<!-- ==================== Abşeron dairəvi xətti (tablo) ==================== -->
<section class="tablo">
  <div class="container-fluid">
    <div class="tablo__top ady-section-head">
      <div>
        <div class="ady-eyebrow"><%= t('nav.timetable') %></div>
        <h2><%= t('home.absheronTitle') %></h2>
        <p><%= serverDate %> · <%= t('home.absheronSub') %></p>
      </div>
      <a href="/<%= locale %>/hereket-cedveli" class="btn btn-blue-transparent"><%= t('home.fullTimetable') %></a>
    </div>

    <div class="tablo__table">
      <div class="table-wrap">
        <table class="data">
          <thead>
            <tr>
              <th><%= t('table.train') %></th>
              <th><%= t('stn.BAK') %></th><th><%= t('stn.BIL') %></th><th><%= t('stn.XRD') %></th><th><%= t('stn.SUM') %></th>
              <th><%= t('table.price') %></th><th></th>
            </tr>
          </thead>
          <tbody>
            <% timetable.absheron.slice(0, 12).forEach(function (trip) { %>
              <tr>
                <td class="num"><strong><%= trip.number %></strong></td>
                <% ['BAK', 'BIL', 'XRD', 'SUM'].forEach(function (code) { %>
                  <% var st = trip.stopMap[code]; %>
                  <td class="num"><%= st ? (st.depart || st.arrive || '—') : '—' %></td>
                <% }) %>
                <td class="num"><%= (trip.minPrice || 0).toFixed(2) %> ₼</td>
                <td><a href="/<%= locale %>/reysler?from=BAK&to=SUM&date=<%= serverDate %>&passengers=1" class="btn btn-blue btn--small"><%= t('home.buyTicket') %></a></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>

<!-- ==================== Ölkədaxili və beynəlxalq reyslər ==================== -->
<section class="section">
  <div class="container-fluid">
    <div class="ady-tabs">
      <button class="ady-tab is-active" data-tab="domestic" data-tab-group="homeLines"><%= t('home.domestic') %></button>
      <button class="ady-tab" data-tab="georgia" data-tab-group="homeLines"><%= t('home.georgia') %></button>
      <button class="ady-tab" data-tab="international" data-tab-group="homeLines"><%= t('home.international') %></button>
    </div>

    <% ['domestic', 'georgia', 'international'].forEach(function (lineKey) { %>
      <div data-panel="<%= lineKey %>" data-panel-group="homeLines" class="ady-panel <%= lineKey === 'domestic' ? 'is-active' : '' %>">
        <div class="table-wrap">
          <table class="data">
            <thead><tr><th><%= t('table.train') %></th><th><%= t('table.route') %></th><th><%= t('table.depart') %></th><th><%= t('table.arrive') %></th><th><%= t('table.price') %></th><th></th></tr></thead>
            <tbody>
              <% timetable[lineKey].forEach(function (trip) { %>
                <tr>
                  <td class="num"><strong><%= trip.number %></strong></td>
                  <td><%= trip.title %></td>
                  <td class="num"><%= trip.depart %></td>
                  <td class="num"><%= trip.arrive %></td>
                  <td class="num"><%= trip.minPrice.toFixed(2) %> ₼</td>
                  <td><a href="/<%= locale %>/reysler?from=<%= trip.from %>&to=<%= trip.to %>&date=<%= serverDate %>&passengers=1" class="btn btn-blue btn--small"><%= t('home.buyTicket') %></a></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    <% }) %>
  </div>
</section>

<!-- ==================== Populyar istiqamətlər ==================== -->
<section class="section">
  <div class="container-fluid">
    <div class="ady-section-head">
      <div>
        <div class="ady-eyebrow"><%= t('home.travel') %></div>
        <h2><%= t('home.popular') %></h2>
        <p><%= t('home.discover') %></p>
      </div>
      <a href="/<%= locale %>/populyar-istiqametler" class="btn btn-blue-transparent"><%= t('home.seeAll') %></a>
    </div>
    <div class="grid grid--4">
      <% destinations.forEach(function (d) { %>
        <a href="/<%= locale %>/populyar-istiqametler/<%= d.slug %>" class="card ady-dest">
          <div class="ady-dest__img"><img src="<%= d.image %>" alt="<%= d.title %>" loading="lazy" /></div>
          <div class="card__body">
            <h3><%= d.title %></h3>
            <div class="ady-dest__meta">
              <span><strong><%= d.priceFrom.toFixed(2) %></strong> ₼</span>
              <span><%= d.durationText %></span>
            </div>
          </div>
        </a>
      <% }) %>
    </div>
  </div>
</section>

<!-- ==================== Xəbərlər ==================== -->
<section class="section">
  <div class="container-fluid">
    <div class="ady-section-head">
      <div><div class="ady-eyebrow"><%= t('nav.news') %></div><h2><%= t('home.news') %></h2></div>
      <a href="/<%= locale %>/xeberler" class="btn btn-blue-transparent"><%= t('home.allNews') %></a>
    </div>
    <div class="grid grid--3">
      <% news.forEach(function (n) { %>
        <a href="/<%= locale %>/xeberler/<%= n.slug %>" class="card ady-news">
          <div class="card__body">
            <div class="ady-news__meta"><%= new Date(n.publishedAt).toLocaleDateString(dateLocale) %></div>
            <h3><%= n.title %></h3>
            <p><%= n.excerpt %></p>
            <span class="ady-more"><%= t('home.readMore') %></span>
          </div>
        </a>
      <% }) %>
    </div>
  </div>
</section>

<!-- ==================== FAQ ==================== -->
<section class="section">
  <div class="container-fluid">
    <div class="ady-section-head">
      <div><div class="ady-eyebrow"><%= t('home.questionEyebrow') %></div><h2><%= t('home.faq') %></h2></div>
      <a href="/<%= locale %>/sualim-var/suallar" class="btn btn-blue-transparent"><%= t('home.allFaq') %></a>
    </div>
    <div class="grid grid--2">
      <% faqs.forEach(function (f) { %>
        <div class="faq">
          <div class="faq__q"><%= f.question %></div>
          <div class="faq__a"><%= f.answer %></div>
        </div>
      <% }) %>
    </div>
  </div>
</section>

<!-- ==================== Abunə ==================== -->
<section class="section">
  <div class="container-fluid">
    <div class="ady-subscribe">
      <div>
        <h2><%= t('footer.subscribe') %></h2>
        <p><%= t('home.subscribeText') %></p>
      </div>
      <form class="subscribe ady-subscribe__form" id="subscribeForm">
        <input type="email" name="email" placeholder="<%= t('footer.email') %>" required />
        <button type="submit" class="btn btn-blue"><%= t('footer.subscribeBtn') %></button>
      </form>
    </div>
  </div>
</section>

<script>
  window.ADY_STATIONS = <%- JSON.stringify(stations.map(function (s) { return { code: s.code, name: s.name, nameEn: s.nameEn, region: s.region }; })) %>;
</script>
<script>
  /* Populyar xidmət kartları karuseli: ox düymələri + avto-sürüşdürmə */
  (function () {
    var rail = document.getElementById('usefullyRail');
    if (!rail) return;
    var nextBtn = document.getElementById('railNext');
    var prevBtn = document.getElementById('railPrev');
    var timer = null;
    function step() {
      var card = rail.querySelector('.usefully__item');
      return card ? card.getBoundingClientRect().width + 24 : 320;
    }
    function maxLeft() { return rail.scrollWidth - rail.clientWidth; }
    function go(dir) {
      var target = rail.scrollLeft + dir * step();
      if (dir > 0 && target >= maxLeft() - 4) rail.scrollTo({ left: 0, behavior: 'smooth' });
      else rail.scrollTo({ left: Math.max(0, target), behavior: 'smooth' });
    }
    if (nextBtn) nextBtn.addEventListener('click', function () { go(1); restart(); });
    if (prevBtn) prevBtn.addEventListener('click', function () { go(-1); restart(); });
    function start() { timer = setInterval(function () { go(1); }, 4000); }
    function stop() { if (timer) { clearInterval(timer); timer = null; } }
    function restart() { stop(); start(); }
    rail.addEventListener('mouseenter', stop);
    rail.addEventListener('mouseleave', start);
    rail.addEventListener('touchstart', stop, { passive: true });
    start();
  })();
</script>
