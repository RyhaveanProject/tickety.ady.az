<section class="hero">
  <img class="hero__banner" src="/assets/ady/banner-1.svg" alt="ADY sərnişin qatarı" />
  <div class="hero__inner">
    <div class="eyebrow"><%= t('brand.railways') %></div>
    <h1><%= t('home.heroTitle') %></h1>
    <p class="hero__sub"><%= t('home.heroSub') %></p>
    <div class="hero__stats">
      <div class="hero__stat"><strong><%= timetable.absheron.length %></strong><span><%= t('home.statAbsheron') %></span></div>
      <div class="hero__stat"><strong><%= timetable.domestic.length %></strong><span><%= t('home.statDomestic') %></span></div>
      <div class="hero__stat"><strong><%= timetable.georgia.length %></strong><span><%= t('home.statGeorgia') %></span></div>
      <div class="hero__stat"><strong><%= stations.length %></strong><span><%= t('home.statStations') %></span></div>
    </div>
  </div>
</section>

<div class="container">
  <%- include('../partials/search-form', { stations: stations, today: serverDate, maxDate: serverDateMax, prefill: null }) %>
</div>

<!-- ==================== Xidmət kartları ==================== -->
<section class="section section--tight">
  <div class="container">
    <div class="grid grid--4">
      <% homeCards.forEach(function(c){ %>
        <a href="/<%= locale %>/<%= c.href %>" class="card">
          <img src="<%= c.image %>" alt="<%= c.title %>" style="width:100%;height:130px;object-fit:cover" />
          <div class="card__body">
            <h3 style="font-size:1rem"><%= c.title %></h3>
            <p style="color:var(--ink-2);font-size:.875rem;margin:0 0 10px"><%= c.text %></p>
            <span class="feature__link"><%= c.action %></span>
          </div>
        </a>
      <% }) %>
      <a href="/<%= locale %>/hereket-cedveli" class="card">
        <img src="/assets/ady/card-popular.svg" alt="Hərəkət cədvəli" style="width:100%;height:130px;object-fit:cover" />
        <div class="card__body">
          <h3 style="font-size:1rem">Hərəkət cədvəli</h3>
          <p style="color:var(--ink-2);font-size:.875rem;margin:0 0 10px">Bütün reyslər, dayanacaqlar və gediş vaxtları.</p>
          <span class="feature__link">Ətraflı oxu</span>
        </div>
      </a>
    </div>
  </div>
</section>

<!-- ==================== Populyar istiqamətlər — üfüqi karusel ==================== -->
<section class="section">
  <div class="container">
    <div class="section__head">
      <div>
        <div class="eyebrow"><%= t('home.travel') %></div>
        <h2><%= t('home.popular') %></h2>
        <p>ADY ilə Azərbaycanı kəşf et</p>
      </div>
      <div class="rail-nav">
        <a href="/<%= locale %>/populyar-istiqametler" class="btn btn--outline"><%= t('home.seeAll') %></a>
        <button type="button" class="rail-arrow" id="railPrev" aria-label="Əvvəlki">‹</button>
        <button type="button" class="rail-arrow" id="railNext" aria-label="Növbəti">›</button>
      </div>
    </div>

    <div class="dest-rail" id="destRail">
      <% destinations.forEach(function(d){ %>
        <a href="/<%= locale %>/populyar-istiqametler/<%= d.slug %>" class="feature dest-card">
          <div class="feature__img"><img src="<%= d.image %>" alt="<%= d.title %>" loading="lazy" /></div>
          <div class="feature__body">
            <h3><%= d.title %></h3>
            <div class="feature__meta">
              <span><strong><%= d.priceFrom.toFixed(2) %></strong> AZN-dən</span>
              <span><%= d.durationText %></span>
              <span><%= d.distanceKm %> km</span>
            </div>
            <span class="feature__link"><%= t('home.readMore') %></span>
          </div>
        </a>
      <% }) %>
    </div>
  </div>
</section>

<!-- ==================== Abşeron dairəvi xətti ==================== -->
<section class="section" style="background:#fff;border-top:1px solid var(--line);border-bottom:1px solid var(--line)">
  <div class="container">
    <div class="section__head">
      <div>
        <div class="eyebrow"><%= t('nav.timetable') %></div>
        <h2><%= t('home.absheronTitle') %></h2>
        <p><%= serverDate %> · <%= t('home.absheronSub') %></p>
      </div>
      <a href="/<%= locale %>/hereket-cedveli" class="btn btn--outline"><%= t('home.fullTimetable') %></a>
    </div>

    <div class="table-wrap">
      <table class="data">
        <thead>
          <tr>
            <th><%= t('table.train') %></th>
            <th>Bakı</th><th>Biləcəri</th><th>Xırdalan</th><th>Sumqayıt</th>
            <th><%= t('table.price') %></th><th></th>
          </tr>
        </thead>
        <tbody>
          <% timetable.absheron.slice(0, 12).forEach(function(trip){ %>
            <tr>
              <td class="num"><strong><%= trip.number %></strong></td>
              <% ['BAK','BIL','XRD','SUM'].forEach(function(code){ %>
                <% var st = trip.stopMap[code]; %>
                <td class="num"><%= st ? (st.depart || st.arrive || '—') : '—' %></td>
              <% }) %>
              <td class="num"><%= (trip.minPrice || 0).toFixed(2) %> ₼</td>
              <td><a href="/<%= locale %>/reysler?from=BAK&to=SUM&date=<%= serverDate %>&passengers=1" class="btn btn--sm btn--primary"><%= t('home.buyTicket') %></a></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</section>

<!-- ==================== Ölkədaxili və beynəlxalq reyslər ==================== -->
<section class="section">
  <div class="container">
    <div class="timetable-tabs">
      <button class="tab is-active" data-tab="domestic" data-tab-group="homeLines"><%= t('home.domestic') %></button>
      <button class="tab" data-tab="georgia" data-tab-group="homeLines"><%= t('home.georgia') %></button>
      <button class="tab" data-tab="international" data-tab-group="homeLines"><%= t('home.international') %></button>
    </div>

    <% ['domestic','georgia','international'].forEach(function(lineKey){ %>
      <div data-panel="<%= lineKey %>" data-panel-group="homeLines" class="<%= lineKey === 'domestic' ? 'is-active' : '' %>">
        <div class="table-wrap">
          <table class="data">
            <thead><tr><th><%= t('table.train') %></th><th><%= t('table.route') %></th><th><%= t('table.depart') %></th><th><%= t('table.arrive') %></th><th><%= t('table.price') %></th><th></th></tr></thead>
            <tbody>
              <% timetable[lineKey].forEach(function(trip){ %>
                <tr>
                  <td class="num"><strong><%= trip.number %></strong></td>
                  <td><%= trip.title %></td>
                  <td class="num"><%= trip.depart %></td>
                  <td class="num"><%= trip.arrive %></td>
                  <td class="num"><%= trip.minPrice.toFixed(2) %> ₼</td>
                  <td><a href="/<%= locale %>/reysler?from=<%= trip.from %>&to=<%= trip.to %>&date=<%= serverDate %>&passengers=1" class="btn btn--sm btn--primary"><%= t('home.buyTicket') %></a></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    <% }) %>
  </div>
</section>

<!-- ==================== Xəbərlər ==================== -->
<section class="section section--tight">
  <div class="container">
    <div class="section__head">
      <div><div class="eyebrow"><%= t('nav.news') %></div><h2><%= t('home.news') %></h2></div>
      <a href="/<%= locale %>/xeberler" class="btn btn--outline"><%= t('home.allNews') %></a>
    </div>
    <div class="grid grid--3">
      <% news.forEach(function(n){ %>
        <a href="/<%= locale %>/xeberler/<%= n.slug %>" class="feature">
          <div class="feature__body">
            <div class="news-card__meta"><span><%= new Date(n.publishedAt).toLocaleDateString('az-AZ') %></span></div>
            <h3><%= n.title %></h3>
            <p><%= n.excerpt %></p>
            <span class="feature__link"><%= t('home.readMore') %></span>
          </div>
        </a>
      <% }) %>
    </div>
  </div>
</section>

<!-- ==================== FAQ ==================== -->
<section class="section section--tight" style="background:#fff;border-top:1px solid var(--line)">
  <div class="container">
    <div class="section__head">
      <div><div class="eyebrow">Sualım var</div><h2><%= t('home.faq') %></h2></div>
      <a href="/<%= locale %>/sualim-var/suallar" class="btn btn--outline">Bütün suallar</a>
    </div>
    <div class="grid grid--2">
      <% faqs.forEach(function(f){ %>
        <div class="faq">
          <div class="faq__q"><%= f.question %></div>
          <div class="faq__a"><%= f.answer %></div>
        </div>
      <% }) %>
    </div>
  </div>
</section>

<!-- ==================== Abunə ==================== -->
<section class="section section--tight">
  <div class="container">
    <div class="card" style="background:linear-gradient(135deg,#00539b,#003c73);border:0">
      <div class="card__body" style="display:flex;justify-content:space-between;align-items:center;gap:24px;flex-wrap:wrap">
        <div>
          <h2 style="color:#fff;margin-bottom:6px"><%= t('footer.subscribe') %></h2>
          <p style="color:#cfe0f0;margin:0"><%= t('home.subscribeText') %></p>
        </div>
        <form class="subscribe" style="min-width:320px" id="subscribeForm">
          <input type="email" name="email" placeholder="<%= t('footer.email') %>" required />
          <button type="submit" class="btn btn--gold"><%= t('footer.subscribeBtn') %></button>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  window.ADY_STATIONS = <%- JSON.stringify(stations.map(function(s){ return { code: s.code, name: s.name, nameEn: s.nameEn, region: s.region }; })) %>;
</script>
<script>
  /* ====== Populyar istiqamətlər karuseli: avto-sürüşdürmə + ox düymələri ====== */
  (function () {
    var rail = document.getElementById('destRail');
    if (!rail) return;
    var nextBtn = document.getElementById('railNext');
    var prevBtn = document.getElementById('railPrev');
    var timer = null;

    function step() {
      var card = rail.querySelector('.dest-card');
      return card ? card.getBoundingClientRect().width + 16 : 300;
    }
    function maxLeft() { return rail.scrollWidth - rail.clientWidth; }

    function go(dir) {
      var target = rail.scrollLeft + dir * step();
      if (dir > 0 && target >= maxLeft() - 4) {
        rail.scrollTo({ left: 0, behavior: 'smooth' });
      } else {
        rail.scrollTo({ left: Math.max(0, target), behavior: 'smooth' });
      }
    }

    if (nextBtn) nextBtn.addEventListener('click', function () { go(1); restart(); });
    if (prevBtn) prevBtn.addEventListener('click', function () { go(-1); restart(); });

    function start() { timer = setInterval(function () { go(1); }, 4000); }
    function stop() { if (timer) { clearInterval(timer); timer = null; } }
    function restart() { stop(); start(); }

    rail.addEventListener('mouseenter', stop);
    rail.addEventListener('mouseleave', start);
    rail.addEventListener('touchstart', stop, { passive: true });
    start();
  })();
</script>
