<div class="page-head">
  <div class="container">
    <div class="breadcrumb"><a href="/<%= locale %>">Ana səhifə</a> <span>/</span> <a href="/<%= locale %>/kabinet">Kabinet</a> <span>/</span> <span>Sifarişlərim</span></div>
    <h1>Sifarişlərim</h1>
  </div>
</div>

<section class="section">
  <div class="container">
    <div class="account-grid">
      <%- include('../partials/account-nav', { active: 'orders' }) %>

      <div>
        <% if (!orders.length) { %>
          <div class="card"><div class="empty">
            <div class="empty__icon">🧾</div>
            <h3>Sifariş yoxdur</h3>
            <a href="/<%= locale %>/bilet-axtar" class="btn btn--primary">Bilet al</a>
          </div></div>
        <% } else { %>
          <% orders.forEach(function(o){ %>
            <div class="card" style="margin-bottom:16px">
              <div class="card__head">
                <span>Sifariş № <strong><%= o.orderNo %></strong></span>
                <span class="badge <%= o.status === 'paid' ? 'badge--green' : (o.status === 'pending' ? 'badge--gold' : 'badge--gray') %>">
                  <%= { paid: 'Ödənilib', pending: 'Gözləyir', cancelled: 'Ləğv edilib', refunded: 'Qaytarılıb', partially_refunded: 'Qismən qaytarılıb' }[o.status] || o.status %>
                </span>
              </div>
              <div class="card__body">
                <div style="display:flex;gap:26px;flex-wrap:wrap;margin-bottom:14px">
                  <div><small style="color:var(--muted)">Marşrut</small><div style="font-weight:600"><%= o.fromName %> → <%= o.toName %></div></div>
                  <div><small style="color:var(--muted)">Qatar</small><div style="font-weight:600"><%= o.trainNumber %></div></div>
                  <div><small style="color:var(--muted)">Tarix</small><div style="font-weight:600"><%= o.date %> <%= o.departTime %></div></div>
                  <div><small style="color:var(--muted)">Bilet sayı</small><div style="font-weight:600"><%= (o.passengers || []).length %></div></div>
                  <div><small style="color:var(--muted)">Məbləğ</small><div style="font-weight:600"><%= o.total.toFixed(2) %> ₼</div></div>
                </div>
                <div style="display:flex;gap:8px;flex-wrap:wrap">
                  <% if (o.status === 'paid' || o.status === 'partially_refunded') { %>
                    <a href="/<%= locale %>/bilet/<%= o._id %>" class="btn btn--sm btn--primary">Biletə bax</a>
                    <a href="/<%= locale %>/bilet/<%= o._id %>/pdf" class="btn btn--sm btn--outline">PDF yüklə</a>
                  <% } %>
                  <% if (o.status === 'pending') { %>
                    <a href="/<%= locale %>/odenis/<%= o._id %>" class="btn btn--sm btn--gold">Ödənişi tamamla</a>
                    <button type="button" class="btn btn--sm btn--danger" data-cancel-order="<%= o._id %>">Ləğv et</button>
                  <% } %>
                </div>
              </div>
            </div>
          <% }) %>
        <% } %>
      </div>
    </div>
  </div>
</section>
