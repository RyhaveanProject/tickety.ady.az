<div class="page-head">
  <div class="container">
    <div class="breadcrumb"><a href="/<%= locale %>">Ana səhifə</a> <span>/</span> <a href="/<%= locale %>/kabinet">Kabinet</a> <span>/</span> <span>Mənim biletlərim</span></div>
    <h1>Mənim biletlərim</h1>
  </div>
</div>

<section class="section">
  <div class="container">
    <div class="account-grid">
      <%- include('../partials/account-nav', { active: 'tickets' }) %>

      <div>
        <div class="tabs">
          <a href="/<%= locale %>/kabinet/biletler" class="tabs__item <%= !status ? 'is-active' : '' %>">Hamısı</a>
          <a href="/<%= locale %>/kabinet/biletler?status=active" class="tabs__item <%= status === 'active' ? 'is-active' : '' %>">Aktiv</a>
          <a href="/<%= locale %>/kabinet/biletler?status=refunded" class="tabs__item <%= status === 'refunded' ? 'is-active' : '' %>">Qaytarılmış</a>
        </div>

        <% if (!tickets.length) { %>
          <div class="card"><div class="empty">
            <div class="empty__icon">🎫</div>
            <h3>Bilet tapılmadı</h3>
            <p>Bu filtrə uyğun bilet yoxdur.</p>
            <a href="/<%= locale %>/bilet-axtar" class="btn btn--primary">Bilet al</a>
          </div></div>
        <% } else { %>
          <div class="grid grid--2">
            <% tickets.forEach(function(t){ %>
              <div class="card">
                <div class="card__body">
                  <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:12px;margin-bottom:12px">
                    <div>
                      <div style="font-weight:700;font-size:1.05rem"><%= t.fromName %> → <%= t.toName %></div>
                      <div style="font-size:.82rem;color:var(--muted)"><%= t.date %> · <%= t.departTime %></div>
                    </div>
                    <span class="badge <%= t.status === 'active' ? 'badge--green' : (t.status === 'used' ? 'badge--blue' : 'badge--gray') %>">
                      <%= { active: 'Aktiv', used: 'İstifadə olunub', refunded: 'Qaytarılıb' }[t.status] %>
                    </span>
                  </div>
                  <dl class="kv" style="grid-template-columns:110px 1fr;font-size:.83rem">
                    <dt>PNR</dt><dd style="font-family:monospace;letter-spacing:2px;color:var(--ady-blue)"><%= t.pnr %></dd>
                    <dt>Sərnişin</dt><dd><%= t.passengerName %></dd>
                    <dt>Qatar</dt><dd><%= t.trainNumber %></dd>
                    <dt>Vaqon / Yer</dt><dd><%= t.wagon %> / <strong><%= t.seat %></strong> · <%= t.className %></dd>
                    <dt>Qiymət</dt><dd><%= t.price.toFixed(2) %> ₼</dd>
                  </dl>
                  <div style="display:flex;gap:8px;margin-top:14px;flex-wrap:wrap">
                    <a href="/<%= locale %>/kabinet/bilet/<%= t._id %>" class="btn btn--sm btn--primary">Bax</a>
                    <a href="/<%= locale %>/bilet/<%= t.order %>/pdf" class="btn btn--sm btn--outline">PDF</a>
                    <% if (t.status === 'active') { %>
                      <button type="button" class="btn btn--sm btn--danger" data-refund="<%= t._id %>">Qaytar</button>
                    <% } %>
                  </div>
                </div>
              </div>
            <% }) %>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</section>
