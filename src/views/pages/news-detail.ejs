<div class="page-head">
  <div class="container">
    <div class="breadcrumb">
      <a href="/<%= locale %>">Ana səhifə</a> <span>/</span>
      <a href="/<%= locale %>/xeberler">Xəbərlər</a> <span>/</span> <span><%= item.title %></span>
    </div>
    <h1><%= item.title %></h1>
    <div class="news-card__meta"><span><%= new Date(item.publishedAt).toLocaleDateString('az-AZ') %></span></div>
  </div>
</div>

<section class="section">
  <div class="container">
    <div class="two-col">
      <article class="prose">
        <% if (item.image) { %><img src="<%= item.image %>" alt="<%= item.title %>" /><% } %>
        <%- item.content %>
        <% if (item.sourceUrl) { %>
          <p style="font-size:.85rem;color:var(--muted);margin-top:24px">
            Mənbə: <a href="<%= item.sourceUrl %>" target="_blank" rel="noopener"><%= item.sourceUrl %></a>
          </p>
        <% } %>
      </article>
      <aside>
        <div class="card">
          <div class="card__head">Digər xəbərlər</div>
          <div class="card__body">
            <% others.forEach(function(o){ %>
              <a href="/<%= locale %>/xeberler/<%= o.slug %>" style="display:block;padding:10px 0;border-bottom:1px solid var(--line);font-size:.9rem;color:var(--ink)">
                <strong style="display:block;color:var(--ady-blue)"><%= o.title %></strong>
                <small style="color:var(--muted)"><%= new Date(o.publishedAt).toLocaleDateString('az-AZ') %></small>
              </a>
            <% }) %>
          </div>
        </div>
      </aside>
    </div>
  </div>
</section>
