<div class="page-head">
  <div class="container">
    <div class="breadcrumb"><a href="/<%= locale %>">Ana səhifə</a> <span>/</span> <span>Xəbərlər</span></div>
    <h1>Xəbərlər</h1>
    <p style="color:var(--ink-2);margin:0"><%= total %> xəbər</p>
  </div>
</div>

<section class="section">
  <div class="container">
    <div class="grid grid--3">
      <% items.forEach(function(n){ %>
        <a href="/<%= locale %>/xeberler/<%= n.slug %>" class="feature">
          <% if (n.image) { %><img src="<%= n.image %>" alt="<%= n.title %>" class="feature__img" loading="lazy" /><% } %>
          <div class="feature__body">
            <div class="news-card__meta"><span><%= new Date(n.publishedAt).toLocaleDateString('az-AZ') %></span></div>
            <h3><%= n.title %></h3>
            <p><%= n.excerpt %></p>
            <span class="feature__link">Ətraflı →</span>
          </div>
        </a>
      <% }) %>
    </div>

    <% if (pages > 1) { %>
      <div style="display:flex;gap:8px;justify-content:center;margin-top:32px">
        <% for (var p = 1; p <= pages; p++) { %>
          <a href="?page=<%= p %>" class="tbtn <%= p === page ? 'is-active' : '' %>"><%= p %></a>
        <% } %>
      </div>
    <% } %>
  </div>
</section>
