<section class="section">
  <div class="container">
    <div class="section__head">
      <div>
        <div class="eyebrow"><%= order.orderNo %></div>
        <h1><%= t('payment.title') %></h1>
        <p><%= order.fromName %> — <%= order.toName %> · <%= order.date %> · <%= order.passengers.length %> <%= t('checkout.passenger') %></p>
      </div>
    </div>

    <div class="layout-aside">
      <div>
        <div class="card"><div class="card__body">
          <div id="payNote" class="hidden alert"></div>

          <% if (savedCards.length) { %>
            <h3 style="font-size:1rem;margin:0 0 12px">Saxlanılmış kartlarım</h3>
            <div class="saved-cards" id="savedCards">
              <% savedCards.forEach(function(c){ %>
                <button type="button" class="saved-card" data-saved-card="<%= c.cardId %>">
                  <span class="saved-card__brand"><%= (c.brand || 'kart').toUpperCase() %></span>
                  <span class="mono saved-card__num"><%= c.masked %></span>
                  <span class="saved-card__meta"><%= c.holder %> · <%= c.expiry %></span>
                </button>
              <% }) %>
            </div>
            <p class="sec-note">və ya yeni kartla ödəyin:</p>
          <% } %>

          <form id="payForm" data-order-id="<%= order._id %>">
            <div class="card-visual">
              <div class="flex-between">
                <span class="card-visual__brand" id="visualBrand"><%= t('payment.cardVisual') %></span>
                <svg width="34" height="22" viewBox="0 0 34 22" aria-hidden="true"><rect width="34" height="22" rx="3" fill="#f2a900"/><path d="M0 7h34M0 15h34" stroke="#3a2600" stroke-width="1.4"/></svg>
              </div>
              <div class="card-visual__number" id="visualNumber">•••• •••• •••• ••••</div>
              <div class="card-visual__row">
                <span id="visualHolder"><%= t('payment.cardHolderPlaceholder') %></span>
                <span id="visualExpiry"><%= t('payment.expiryPlaceholder') %></span>
              </div>
            </div>

            <div class="field">
              <label for="cardNumber"><%= t('payment.cardNumber') %></label>
              <input type="text" id="cardNumber" name="number" data-card-number placeholder="0000 0000 0000 0000" inputmode="numeric" autocomplete="cc-number" maxlength="23" required />
            </div>
            <div class="field">
              <label for="cardHolder"><%= t('payment.cardHolder') %></label>
              <input type="text" id="cardHolder" name="holder" placeholder="<%= t('payment.cardHolderPlaceholder') %>" autocomplete="cc-name" required />
            </div>
            <div class="field--row">
              <div class="field">
                <label for="cardExpiry"><%= t('payment.expiry') %></label>
                <input type="text" id="cardExpiry" name="expiry" data-card-expiry placeholder="<%= t('payment.expiryPlaceholder') %>" inputmode="numeric" autocomplete="cc-exp" maxlength="5" required />
              </div>
              <div class="field">
                <label for="cardCvv"><%= t('payment.cvv') %></label>
                <input type="password" id="cardCvv" name="cvv" data-card-cvv placeholder="000" inputmode="numeric" autocomplete="cc-csc" maxlength="4" required />
              </div>
            </div>

            <label class="check">
              <input type="checkbox" name="saveCard" checked />
              <span>Kartı hesabımda saxla — növbəti ödənişdə yenidən yazmayım</span>
            </label>

            <div class="alert alert--info text-sm">
              3-D Secure kodu bu mərhələdə istənilmir. Kart təsdiqləndikdən sonra telefonunuza gələn OTP kodu üçün ayrıca ekran açılacaq.
            </div>

            <button type="submit" class="btn btn--primary btn--block btn--lg">Ödənişi təsdiqlə — <%= order.total.toFixed(2) %> ₼</button>
          </form>
        </div></div>
      </div>

      <div class="summary">
        <div class="card"><div class="card__body">
          <h3 style="font-size:1rem"><%= t('checkout.summary') %></h3>
          <div class="summary__row"><span><%= t('results.train') %></span><span><%= order.trainNumber %></span></div>
          <div class="summary__row"><span><%= t('common.date') %></span><span><%= order.date %></span></div>
          <div class="summary__row"><span><%= t('table.depart') %></span><span><%= order.departTime %></span></div>
          <% order.passengers.forEach(function(p){ %>
            <div class="summary__row"><span><%= t('seats.wagon') %> <%= p.wagon %> · <%= p.seat %> — <%= p.className %></span><span class="mono"><%= p.price.toFixed(2) %> ₼</span></div>
          <% }) %>
          <div class="summary__total"><span><%= t('checkout.total') %></span><span class="mono"><%= order.total.toFixed(2) %> ₼</span></div>
        </div></div>
      </div>
    </div>
  </div>
</section>

<style>
  .saved-cards { display: grid; gap: 10px; margin-bottom: 18px; }
  .saved-card { display: grid; gap: 2px; text-align: left; padding: 12px 14px; border: 1px solid var(--line);
    border-radius: 10px; background: #fff; cursor: pointer; transition: .15s; }
  .saved-card:hover { border-color: var(--ady-blue); box-shadow: 0 0 0 3px rgba(0,83,155,.08); }
  .saved-card__brand { font-size: .72rem; letter-spacing: .12em; color: var(--ady-blue); font-weight: 700; }
  .saved-card__num { font-size: 1.02rem; }
  .saved-card__meta { font-size: .78rem; color: var(--ink-3); }
  .check { display: flex; gap: 10px; align-items: flex-start; font-size: .86rem; margin-bottom: 16px; }
</style>
