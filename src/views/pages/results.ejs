<div class="page-head">
  <div class="container">
    <div class="breadcrumb"><a href="/<%= locale %>">Ana səhifə</a> <span>/</span> <span>Reyslər</span></div>
    <h1><%= fromName %> → <%= toName %></h1>
    <p style="color:var(--ink-2);margin:0"><%= dateText %> · <%= passengers %> sərnişin</p>
  </div>
</div>

<div class="container" style="margin-top:-6px">
  <%- include('../partials/search-form', { stations: stations, today: date, maxDate: date, prefill: { from: from, to: to, date: date, passengers: passengers } }) %>
</div>

<section class="section">
  <div class="container">
    <div style="display:flex;justify-content:space-between;align-items:center;gap:16px;margin-bottom:18px;flex-wrap:wrap">
      <h2 style="margin:0;font-size:1.2rem"><%= results.length %> reys tapıldı</h2>
      <a href="/<%= locale %>/bilet-axtar" class="btn btn--ghost btn--sm">← Yeni axtarış</a>
    </div>

    <% if (!results.length) { %>
      <div class="card">
        <div class="empty">
          <div class="empty__icon">🔍</div>
          <h3>Uyğun reys tapılmadı</h3>
          <p>Bu tarixdə <%= fromName %> → <%= toName %> istiqamətində reys yoxdur. Başqa tarix seçin.</p>
          <a href="/<%= locale %>/bilet-axtar" class="btn btn--primary">Yenidən axtar</a>
        </div>
      </div>
    <% } else { %>
      <% results.forEach(function(r){ %>
        <div class="trip" data-trip>
          <div>
            <div class="trip__route">
              <div class="trip__point">
                <strong><%= r.departTime %></strong>
                <span><%= r.fromName %></span>
              </div>
              <div class="trip__mid">
                <div class="trip__dur"><%= r.durationText %></div>
                <div class="trip__line"></div>
                <div class="trip__dur"><%= r.stopsCount %> dayanacaq</div>
              </div>
              <div class="trip__point">
                <strong><%= r.arriveTime %></strong>
                <span><%= r.toName %></span>
              </div>
            </div>
            <div class="trip__meta">
              <span>🚆 Qatar <strong><%= r.trainNumber %></strong></span>
              <span><%= r.trainTitle %></span>
              <span class="badge <%= r.line === 'absheron' ? 'badge--blue' : 'badge--gold' %>">
                <%= r.line === 'absheron' ? 'Abşeron xətti' : 'Ölkədaxili' %>
              </span>
            </div>
          </div>

          <div class="trip__right">
            <div class="trip__classes" data-classes>
              <% r.classes.forEach(function(c, i){ %>
                <button type="button" class="chip <%= i === 0 ? 'is-active' : '' %>"
                        data-class-code="<%= c.code %>"
                        data-class-price="<%= c.price %>"
                        data-class-wagons="<%= c.wagons %>"
                        data-class-rows="<%= c.rows %>"
                        data-class-perrow="<%= c.seatsPerRow %>"
                        data-class-avail="<%= c.available %>"
                        title="<%= c.title %> — <%= c.available %> yer boş">
                  <%= c.title %> · <%= c.price.toFixed(2) %> ₼
                </button>
              <% }) %>
            </div>
            <div class="trip__price">
              <span data-price><%= r.minPrice.toFixed(2) %></span> <small>₼ / sərnişin</small>
            </div>
            <div style="font-size:.78rem;color:var(--muted);margin:4px 0 8px" data-avail>
              <%= r.classes[0] ? r.classes[0].available + ' yer boş' : '' %>
            </div>
            <a class="btn btn--primary" data-select
               href="/<%= locale %>/yer-secimi/<%= r.tripId %>?from=<%= from %>&to=<%= to %>&passengers=<%= passengers %>&class=<%= r.classes[0] ? r.classes[0].code : '' %>">
              Seç
            </a>
          </div>
        </div>
      <% }) %>
    <% } %>
  </div>
</section>

<script>
  document.querySelectorAll('[data-trip]').forEach(function (trip) {
    var chips = trip.querySelectorAll('[data-classes] .chip');
    var price = trip.querySelector('[data-price]');
    var avail = trip.querySelector('[data-avail]');
    var select = trip.querySelector('[data-select]');
    chips.forEach(function (chip) {
      chip.addEventListener('click', function () {
        chips.forEach(function (c) { c.classList.remove('is-active'); });
        chip.classList.add('is-active');
        price.textContent = Number(chip.dataset.classPrice).toFixed(2);
        avail.textContent = chip.dataset.classAvail + ' yer boş · ' + chip.dataset.classWagons + ' vaqon';
        var url = new URL(select.href, window.location.origin);
        url.searchParams.set('class', chip.dataset.classCode);
        select.href = url.toString();
      });
    });
  });
</script>
