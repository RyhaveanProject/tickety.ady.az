<div class="page-head">
  <div class="container">
    <div class="breadcrumb"><a href="/<%= locale %>">Ana səhifə</a> <span>/</span> <span>Daşıma qaydaları</span></div>
    <h1>Daşıma qaydaları</h1>
    <p style="color:var(--ink-2);margin:0">Sərnişin daşınması, əl yükləri, uşaqlarla və heyvanlarla səyahət qaydaları</p>
  </div>
</div>

<section class="section">
  <div class="container">
    <div class="grid grid--3">
      <% items.forEach(function(p){ %>
        <a href="/<%= locale %>/dasima-qaydalari/<%= p.slug %>" class="feature">
          <% if (p.image) { %><img src="<%= p.image %>" alt="<%= p.title %>" class="feature__img" loading="lazy" /><% } %>
          <div class="feature__body">
            <h3><%= p.title %></h3>
            <p><%= p.excerpt %></p>
            <span class="feature__link">Ətraflı oxu →</span>
          </div>
        </a>
      <% }) %>
    </div>
  </div>
</section>
