<section class="section">
  <div class="container">
    <div class="section__head">
      <div>
        <div class="eyebrow"><%= fromName %> — <%= toName %></div>
        <h1><%= t('seats.title') %></h1>
        <p><%= t('seats.sub') %> · <%= t('seats.need') %>: <strong><%= passengers %></strong></p>
      </div>
      <a href="/<%= locale %>/reysler?from=<%= from %>&to=<%= to %>&date=<%= trip.date %>&passengers=<%= passengers %>" class="btn btn--outline"><%= t('seats.back') %></a>
    </div>

    <div class="seat-legend">
      <span><i class="free"></i><%= t('seats.free') %></span>
      <span><i class="taken"></i><%= t('seats.taken') %></span>
      <span><i class="blocked"></i><%= t('seats.blocked') %></span>
      <span><i class="sel"></i><%= t('seats.selected') %></span>
    </div>

    <%/* ============ 1-ci səviyyə: Sinif tabları (qiymət yanında) ============ */%>
    <div class="class-tabs" id="classTabs">
      <% classMaps.forEach(function(map, mi){ if (!map) return; %>
        <button type="button"
                class="class-tab <%= mi === 0 ? 'is-active' : '' %>"
                data-class-tab="<%= map.code %>"
                data-class-price="<%= map.price.toFixed(2) %>">
          <span class="class-tab__title"><%= map.title %></span>
          <span class="class-tab__price"><%= map.price.toFixed(2) %> ₼</span>
          <span class="class-tab__free"><%= t('seats.freeCount') %>: <%= map.freeCount %></span>
        </button>
      <% }) %>
    </div>

    <%/* ============ 2-ci səviyyə: Vaqon seçimi ============ */%>
    <% classMaps.forEach(function(map, mi){ if (!map) return; %>
      <div class="class-panel <%= mi === 0 ? 'is-active' : '' %>" data-class-panel="<%= map.code %>"
           data-class-code="<%= map.code %>" data-class-title="<%= map.title %>" data-class-price="<%= map.price %>">

        <div class="wagon-picker">
          <% map.wagons.forEach(function(w){ %>
            <button type="button"
                    class="wagon-pill <%= w.wagon === 1 ? 'is-active' : '' %>"
                    data-wagon-pill="<%= w.wagon %>"
                    data-wagon-free="<%= w.seats.length - w.takenCount %>">
              <span class="wagon-pill__no"><%= t('seats.wagon') %> <%= w.wagon %></span>
              <span class="wagon-pill__free"><%= w.seats.length - w.takenCount %> <%= t('seats.freeShort') %></span>
            </button>
          <% }) %>
        </div>

        <% map.wagons.forEach(function(w){ %>
          <div class="wagon" data-wagon="<%= w.wagon %>" data-class="<%= map.code %>" <%= w.wagon === 1 ? '' : 'style="display:none"' %>>
            <div class="wagon__head">
              <span><%= t('seats.wagon') %> <%= w.wagon %> · <%= map.title %> · <%= map.price.toFixed(2) %> ₼</span>
              <span class="sec-note"><%= t('seats.taken') %>: <%= w.takenCount %></span>
            </div>
            <div class="wagon__grid">
              <% w.seats.forEach(function(s){ %>
                <button type="button"
                        class="seat <%= s.taken ? 'is-taken' : '' %>"
                        data-seat="<%= s.seat %>"
                        data-wagon="<%= w.wagon %>"
                        data-class="<%= map.code %>"
                        data-price="<%= map.price %>"
                        data-class-title="<%= map.title %>"
                        <%= s.taken ? 'disabled' : '' %>><%= s.seat %></button>
              <% }) %>
            </div>
          </div>
        <% }) %>
      </div>
    <% }) %>

    <div class="card" style="position:sticky;bottom:16px;margin-top:20px">
      <div class="card__body" style="display:flex;justify-content:space-between;align-items:center;gap:20px;flex-wrap:wrap">
        <div>
          <div class="sec-note"><%= t('seats.selected') %></div>
          <div id="selectedSeats" style="font-weight:600"><%= t('seats.noneSelected') %></div>
        </div>
        <div style="text-align:right">
          <div class="sec-note"><%= t('checkout.total') %></div>
          <div class="trip__price" id="selectedTotal">0.00 ₼</div>
        </div>
        <button type="button" class="btn btn--primary btn--lg" id="continueBtn" disabled><%= t('seats.continue') %></button>
      </div>
    </div>
  </div>
</section>

<script>
  (function () {
    var tripId = '<%= trip._id %>';
    var from = '<%= from %>';
    var to = '<%= to %>';
    var need = <%= passengers %>;
    var locale = '<%= locale %>';
    var selected = [];

    /* ===== Sinif tabları: yalnız seçilmiş sinifin paneli görünür ===== */
    document.querySelectorAll('[data-class-tab]').forEach(function (tab) {
      tab.addEventListener('click', function () {
        var code = tab.getAttribute('data-class-tab');
        document.querySelectorAll('[data-class-tab]').forEach(function (t) { t.classList.remove('is-active'); });
        tab.classList.add('is-active');
        document.querySelectorAll('[data-class-panel]').forEach(function (p) {
          p.classList.toggle('is-active', p.getAttribute('data-class-panel') === code);
        });
      });
    });

    /* ===== Vaqon pill-ləri: yalnız seçilmiş vaqonun sxemi görünür ===== */
    document.querySelectorAll('[data-wagon-pill]').forEach(function (pill) {
      pill.addEventListener('click', function () {
        var panel = pill.closest('[data-class-panel]');
        var wagonNo = pill.getAttribute('data-wagon-pill');
        panel.querySelectorAll('[data-wagon-pill]').forEach(function (p) { p.classList.remove('is-active'); });
        pill.classList.add('is-active');
        panel.querySelectorAll('.wagon').forEach(function (el) {
          el.style.display = el.getAttribute('data-wagon') === wagonNo ? 'block' : 'none';
        });
      });
    });

    function render() {
      var box = document.getElementById('selectedSeats');
      var total = selected.reduce(function (s, x) { return s + Number(x.price); }, 0);
      document.getElementById('selectedTotal').textContent = total.toFixed(2) + ' ₼';
      box.textContent = selected.length
        ? selected.map(function (x) { return x.className + ' · ' + x.wagon + '/' + x.seat; }).join('  |  ')
        : '<%= t("seats.noneSelected") %>';
      document.getElementById('continueBtn').disabled = selected.length !== need;
    }

    document.querySelectorAll('.seat').forEach(function (btn) {
      btn.addEventListener('click', function () {
        if (btn.disabled) return;
        var seat = btn.getAttribute('data-seat');
        var wagon = btn.getAttribute('data-wagon');
        var cls = btn.getAttribute('data-class');
        var idx = selected.findIndex(function (x) { return x.seat === seat && x.wagon === wagon && x.classCode === cls; });
        if (idx > -1) {
          selected.splice(idx, 1);
          btn.classList.remove('is-selected');
        } else {
          if (selected.length >= need) {
            window.toast('<%= t("seats.max") %> ' + need);
            return;
          }
          selected.push({ seat: seat, wagon: Number(wagon), classCode: cls, price: Number(btn.getAttribute('data-price')), className: btn.getAttribute('data-class-title') });
          btn.classList.add('is-selected');
        }
        render();
      });
    });

    document.getElementById('continueBtn').addEventListener('click', function () {
      var q = 'from=' + from + '&to=' + to + '&seats=' + encodeURIComponent(JSON.stringify(selected));
      window.location.href = '/' + locale + '/rezervasyon/' + tripId + '?' + q;
    });

    render();
  })();
</script>
