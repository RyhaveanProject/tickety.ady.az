<section class="section">
  <div class="container-fluid">
    <div style="max-width:820px;margin:0 auto">
      <div class="card mb-16"><div class="card__body text-center">
        <div class="ady-ok">✓</div>
        <h1 style="font-size:1.5rem"><%= t('success.title') %></h1>
        <p class="sec-note"><%= t('success.sub') %></p>
        <div class="mono ady-pnr"><%= order.pnr %></div>
        <div class="sec-note"><%= t('success.pnr') %></div>
        <% if (isGuestOrder) { %>
          <div class="alert alert--info mt-16" style="text-align:left">
            Sifariş qonaq kimi tamamlandı. Bileti istənilən vaxt <strong>PNR kodu</strong> ilə
            <a href="/<%= locale %>/bilet-goruntule/<%= order.pnr %>">bilet görüntüləmə</a> səhifəsindən aça bilərsiniz.
            Biletlər qeyd etdiyiniz e-poçt ünvanına da göndərilir.
          </div>
        <% } %>
      </div></div>

      <% tickets.forEach(function (tk) { %>
        <div class="card mb-16"><div class="card__body">
          <div class="flex-between mb-16">
            <div>
              <h3><%= order.trainNumber %> · <%= order.trainTitle %></h3>
              <div class="sec-note"><%= order.fromName %> — <%= order.toName %> · <%= order.date %> · <%= order.departTime %></div>
            </div>
            <span class="badge badge--green"><%= t('status.confirmed') %></span>
          </div>
          <dl class="kv">
            <dt><%= t('account.pnr') %></dt><dd class="mono"><%= tk.pnr %></dd>
            <dt><%= t('checkout.passenger') %></dt><dd><%= tk.passengerName %></dd>
            <dt><%= t('seats.wagon') %> / <%= t('seats.selected') %></dt><dd><%= tk.wagon %> / <%= tk.seat %></dd>
            <dt><%= t('checkout.docType') %></dt><dd><%= tk.className %></dd>
            <dt><%= t('common.price') %></dt><dd class="mono"><%= tk.price.toFixed(2) %> ₼</dd>
          </dl>
          <div class="flex-end mt-16 no-print">
            <a href="/<%= locale %>/bilet/<%= tk._id %>/pdf" class="btn btn-blue btn--small"><%= t('success.download') %></a>
            <a href="/<%= locale %>/bilet-goruntule/<%= tk.pnr %>" class="btn btn-blue-transparent btn--small">Onlayn bax</a>
          </div>
        </div></div>
      <% }) %>

      <div class="flex-end no-print">
        <% if (currentUser) { %>
          <a href="/<%= locale %>/kabinet/biletler" class="btn btn-blue-transparent"><%= t('nav.myTickets') %></a>
          <a href="/<%= locale %>/kabinet" class="btn btn-blue"><%= t('success.toAccount') %></a>
        <% } else { %>
          <a href="/<%= locale %>/qeydiyyat" class="btn btn-blue-transparent"><%= t('nav.register') %></a>
          <a href="/<%= locale %>/bilet-axtar" class="btn btn-blue">Yeni bilet al</a>
        <% } %>
      </div>
    </div>
  </div>
</section>
