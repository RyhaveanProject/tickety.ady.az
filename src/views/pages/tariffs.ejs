<div class="page-head">
  <div class="container">
    <div class="breadcrumb"><a href="/<%= locale %>">Ana səhifə</a> <span>/</span> <span>Tariflər və ödəniş</span></div>
    <h1>Tariflər və ödəniş</h1>
    <p style="color:var(--ink-2);margin:0">Gediş haqqı tarifləri, ödəniş üsulları, tələb olunan sənədlər və gediş haqqının qaytarılması</p>
  </div>
</div>

<section class="section">
  <div class="container">
    <div class="grid grid--2">
      <% items.forEach(function(p){ %>
        <a href="/<%= locale %>/tarifler-ve-odenis/<%= p.slug %>" class="feature">
          <div class="feature__body">
            <h3><%= p.title %></h3>
            <p><%= p.excerpt %></p>
            <span class="feature__link">Ətraflı oxu →</span>
          </div>
        </a>
      <% }) %>
      <% if (!items.length) { %><div class="card" style="grid-column:1/-1"><div class="empty"><p>Məlumat yoxdur.</p></div></div><% } %>
    </div>
  </div>
</section>
