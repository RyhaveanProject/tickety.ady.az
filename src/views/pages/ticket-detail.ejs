<div class="page-head">
  <div class="container">
    <div class="breadcrumb"><a href="/<%= locale %>">Ana səhifə</a> <span>/</span> <a href="/<%= locale %>/kabinet/biletler">Biletlər</a> <span>/</span> <span><%= ticket.pnr %></span></div>
    <h1>Bilet məlumatları</h1>
  </div>
</div>

<section class="section">
  <div class="container" style="max-width:900px">
    <div class="ticket">
      <div class="ticket__head">
        <div>
          <div style="font-size:.78rem;color:#b9cee2">BİLET KODU (PNR)</div>
          <div class="ticket__pnr"><%= ticket.pnr %></div>
        </div>
        <div style="text-align:right">
          <span class="badge <%= ticket.status === 'active' ? 'badge--green' : 'badge--gray' %>">
            <%= { active: 'Aktiv', used: 'İstifadə olunub', refunded: 'Qaytarılıb' }[ticket.status] %>
          </span>
          <div style="font-size:.78rem;color:#b9cee2;margin-top:6px">Qatar <%= ticket.trainNumber %></div>
        </div>
      </div>
      <div class="ticket__body">
        <div>
          <div class="ticket__route">
            <strong><%= ticket.fromName %></strong><span class="arrow">→</span><strong><%= ticket.toName %></strong>
          </div>
          <dl class="kv">
            <dt>Sərnişin</dt><dd><%= ticket.passengerName %></dd>
            <dt>Sənəd nömrəsi</dt><dd><%= ticket.docNumber %></dd>
            <dt>Tarix</dt><dd><%= ticket.date %></dd>
            <dt>Yola düşmə</dt><dd><%= ticket.departTime %></dd>
            <dt>Çatma</dt><dd><%= ticket.arrivalTime %></dd>
            <dt>Vaqon / Yer</dt><dd><%= ticket.wagon %> / <strong><%= ticket.seat %></strong></dd>
            <dt>Sinif</dt><dd><%= ticket.className %></dd>
            <dt>Qiymət</dt><dd><%= ticket.price.toFixed(2) %> AZN</dd>
            <% if (order) { %><dt>Sifariş №</dt><dd><%= order.orderNo %></dd><% } %>
          </dl>
        </div>
        <div class="ticket__qr">
          <img src="https://api.qrserver.com/v1/create-qr-code/?size=260x260&data=<%= encodeURIComponent(ticket.qrData || ticket.pnr) %>" alt="QR" />
          <div style="font-family:monospace;font-size:.8rem;color:var(--muted)"><%= ticket.pnr %></div>
        </div>
      </div>
    </div>

    <div style="display:flex;gap:10px;flex-wrap:wrap;justify-content:center">
      <a href="/<%= locale %>/bilet/<%= ticket.order %>/pdf" class="btn btn--primary">⬇ PDF yüklə</a>
      <button type="button" class="btn btn--outline" onclick="window.print()">🖨 Çap et</button>
      <% if (ticket.status === 'active') { %>
        <button type="button" class="btn btn--danger" data-refund="<%= ticket._id %>">Bileti qaytar</button>
      <% } %>
      <a href="/<%= locale %>/kabinet/biletler" class="btn btn--ghost">← Biletlərə qayıt</a>
    </div>

    <div class="alert alert--info" style="margin-top:24px">
      <strong>Qaytarma qaydası:</strong> Bilet alındıqdan sonrakı 15 dəqiqə ərzində qaytarılarsa xidmət haqqı tutulmur;
      15 dəqiqədən sonra qaytarıldıqda <%= rules.refundServiceFee %> AZN xidmət haqqı tutulur.
    </div>
  </div>
</section>
