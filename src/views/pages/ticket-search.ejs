<section class="section">
  <div class="container-fluid">
    <div class="ady-section-head">
      <div>
        <div class="ady-eyebrow"><%= t('nav.tickets') %></div>
        <h1><%= t('search.pageTitle') %></h1>
        <p><%= t('search.pageSub') %></p>
      </div>
      <% if (!currentUser) { %>
        <div class="ady-guest-note">
          <span>Bilet almaq üçün qeydiyyat tələb olunmur.</span>
          <a href="/<%= locale %>/login" class="btn btn-blue-transparent btn--small"><%= t('nav.login') %></a>
        </div>
      <% } %>
    </div>

    <div class="ady-search-card ady-search-card--page">
      <%- include('../partials/search-form', { stations: stations, today: today, maxDate: maxDate, prefill: prefill }) %>
    </div>

    <div class="grid grid--3" style="margin-top:34px">
      <div class="card"><div class="card__body">
        <h3><%= t('search.howTitle') %></h3>
        <ol class="ady-list">
          <li><%= t('search.how1') %></li>
          <li><%= t('search.how2') %></li>
          <li><%= t('search.how3') %></li>
          <li><%= t('search.how4') %></li>
        </ol>
      </div></div>
      <div class="card"><div class="card__body">
        <h3><%= t('search.rulesTitle') %></h3>
        <ul class="ady-list">
          <li><%= t('search.rule1', rules.maxTicketsPerOrder) %></li>
          <li><%= t('search.rule2', rules.salesOpenDaysBefore) %></li>
          <li><%= t('search.rule3', rules.salesCloseHoursBefore) %></li>
        </ul>
      </div></div>
      <div class="card"><div class="card__body">
        <h3><%= t('search.payTitle') %></h3>
        <p class="sec-note"><%= t('search.payText') %></p>
      </div></div>
    </div>
  </div>
</section>

<script>
  window.ADY_STATIONS = <%- JSON.stringify(stations.map(function (s) { return { code: s.code, name: s.name, nameEn: s.nameEn, region: s.region }; })) %>;
</script>
