<div class="page-head">
  <div class="container">
    <div class="breadcrumb"><a href="/<%= locale %>">Ana səhifə</a> <span>/</span> <span>Hərəkət cədvəli</span></div>
    <h1>Qatarların hərəkət cədvəli və qrafiki</h1>
    <p style="color:var(--ink-2);margin:0">Abşeron dairəvi dəmir yolu xətti və ölkədaxili reyslər</p>
  </div>
</div>

<section class="section">
  <div class="container">
    <div class="alert alert--info">
      <strong>Qeyd:</strong> Ağstafa istiqaməti 15 iyundan Qazaxa qədər uzadılıb. Biletlər satışdadır!
    </div>

    <div class="card" style="margin-bottom:20px">
      <div class="card__body" style="display:flex;gap:14px;align-items:flex-end;flex-wrap:wrap">
        <form method="GET" class="form-row" style="flex:1;min-width:320px;grid-template-columns:1fr 1fr auto;gap:12px;align-items:end">
          <div class="field" style="margin:0">
            <label>Tarix</label>
            <input type="date" name="date" value="<%= date %>" />
          </div>
          <div class="field" style="margin:0">
            <label>Xətt</label>
            <select name="road_type">
              <option value="bxs" <%= roadType === 'bxs' ? 'selected' : '' %>>Abşeron dairəvi xətti</option>
              <option value="domestic" <%= roadType === 'domestic' ? 'selected' : '' %>>Ölkədaxili</option>
              <option value="all" <%= roadType === 'all' ? 'selected' : '' %>>Hamısı</option>
            </select>
          </div>
          <input type="hidden" name="days_type" value="<%= daysType %>" />
          <button type="submit" class="btn btn--primary" style="height:44px">Göstər</button>
        </form>
        <div style="display:flex;gap:8px">
          <a href="?days_type=work_days&road_type=<%= roadType %>&date=<%= date %>" class="tbtn <%= daysType === 'work_days' ? 'is-active' : '' %>">İş günləri</a>
          <a href="?days_type=non_work_days&road_type=<%= roadType %>&date=<%= date %>" class="tbtn <%= daysType === 'non_work_days' ? 'is-active' : '' %>">Qeyri-iş günləri</a>
        </div>
      </div>
    </div>

    <!-- Abşeron xətti -->
    <h2 style="font-size:1.15rem">Abşeron dairəvi xətti</h2>
    <div class="table-wrap" style="margin-bottom:34px">
      <table class="data">
        <thead>
          <tr>
            <th>Stansiya / Qatar</th>
            <% (timetable.absheronStations.length ? timetable.absheronStations : [{code:'BAK',name:'Bakı'},{code:'BIL',name:'Biləcəri'},{code:'XRD',name:'Xırdalan'},{code:'SUM',name:'Sumqayıt'}]).forEach(function(s){ %>
              <th><%= s.name %></th>
            <% }) %>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% var cols = (timetable.absheronStations.length ? timetable.absheronStations.map(function(s){return s.code;}) : ['BAK','BIL','XRD','SUM']); %>
          <% timetable.absheron.forEach(function(t){ %>
            <tr>
              <td><strong class="num"><%= t.number %></strong></td>
              <% cols.forEach(function(code){ %>
                <% var st = t.stops.find(function(s){ return s.code === code; }); %>
                <td class="num"><%= st ? (st.depart || st.arrive || '—') : '—' %></td>
              <% }) %>
              <td><a class="btn btn--sm btn--primary" href="/<%= locale %>/reysler?from=BAK&to=SUM&date=<%= date %>&passengers=1">Bilet al</a></td>
            </tr>
          <% }) %>
          <% if (!timetable.absheron.length) { %>
            <tr><td colspan="<%= cols.length + 2 %>" style="text-align:center;color:var(--muted);padding:30px">Bu tarixdə reys yoxdur</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <!-- Ölkədaxili -->
    <h2 style="font-size:1.15rem">Ölkədaxili reyslər</h2>
    <div class="table-wrap">
      <table class="data">
        <thead>
          <tr>
            <th>Qatar</th><th>Bakı</th><th>Biləcəri</th><th>Ucar</th><th>Yevlax</th><th>Gəncə</th><th>Tovuz</th><th>Ağstafa</th><th>Qazax</th><th></th>
          </tr>
        </thead>
        <tbody>
          <% timetable.domestic.forEach(function(t){ %>
            <tr>
              <td><strong class="num"><%= t.number %></strong></td>
              <% ['BAK','BIL','UCA','YEV','GAN','TOV','AGS','QAZ'].forEach(function(code){ %>
                <% var st = t.stops.find(function(s){ return s.code === code; }); %>
                <td class="num"><%= st ? (st.arrive || st.depart || '—') : '—' %></td>
              <% }) %>
              <td><a class="btn btn--sm btn--primary" href="/<%= locale %>/reysler?from=BAK&to=GAN&date=<%= date %>&passengers=1">Bilet al</a></td>
            </tr>
          <% }) %>
          <% if (!timetable.domestic.length) { %>
            <tr><td colspan="10" style="text-align:center;color:var(--muted);padding:30px">Bu tarixdə reys yoxdur</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</section>
