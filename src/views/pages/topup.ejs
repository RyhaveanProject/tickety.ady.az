<div class="page-head">
  <div class="container">
    <div class="breadcrumb"><a href="/<%= locale %>">Ana səhifə</a> <span>/</span> <span>Balans artırılması</span></div>
    <h1>Balansın artırılması</h1>
    <p style="color:var(--ink-2);margin:0">Vaxta qənaət üçün balansını indi artır</p>
  </div>
</div>

<section class="section">
  <div class="container">
    <div class="account-grid">
      <%- include('../partials/account-nav', { active: 'topup' }) %>

      <div class="two-col" style="gap:24px">
        <div class="card">
          <div class="card__head">Balans artır</div>
          <div class="card__body">
            <div class="alert alert--info">
              Cari balans: <strong id="curBalance"><%= (currentUser.balance || 0).toFixed(2) %> ₼</strong>
            </div>
            <div style="display:flex;gap:10px;flex-wrap:wrap;margin-bottom:18px">
              <% [5,10,20,50,100].forEach(function(v){ %>
                <button type="button" class="tbtn" data-amount="<%= v %>"><%= v %> ₼</button>
              <% }) %>
            </div>
            <form id="topupForm">
              <div class="field">
                <label>Məbləğ (AZN) *</label>
                <input type="number" name="amount" min="1" max="1000" step="0.01" value="20" required />
              </div>
              <div class="field">
                <label>Kart nömrəsi *</label>
                <input type="text" name="cardNumber" placeholder="0000 0000 0000 0000" maxlength="23" inputmode="numeric" required />
              </div>
              <div class="form-row">
                <div class="field"><label>Bitmə tarixi</label><input type="text" name="expiry" placeholder="MM/YY" maxlength="5" /></div>
                <div class="field"><label>CVV</label><input type="password" maxlength="4" placeholder="•••" /></div>
              </div>
              <button type="submit" class="btn btn--gold btn--block btn--lg" id="topupBtn">Balansı artır</button>
            </form>
          </div>
        </div>

        <div class="card">
          <div class="card__head">Son əməliyyatlar</div>
          <div class="card__body">
            <% if (!payments.length) { %>
              <p style="color:var(--muted);margin:0">Əməliyyat yoxdur.</p>
            <% } else { %>
              <% payments.forEach(function(p){ %>
                <div class="summary-row">
                  <span><%= new Date(p.createdAt).toLocaleString('az-AZ') %><br /><small style="color:var(--muted)"><%= p.cardMask || 'Balans' %></small></span>
                  <strong style="color:var(--green)">+<%= p.amount.toFixed(2) %> ₼</strong>
                </div>
              <% }) %>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  (function () {
    var form = document.getElementById('topupForm');
    var btn = document.getElementById('topupBtn');
    var amountInput = form.querySelector('[name=amount]');
    var cardInput = form.querySelector('[name=cardNumber]');

    document.querySelectorAll('[data-amount]').forEach(function (b) {
      b.addEventListener('click', function () {
        document.querySelectorAll('[data-amount]').forEach(function (x) { x.classList.remove('is-active'); });
        b.classList.add('is-active');
        amountInput.value = b.dataset.amount;
      });
    });

    cardInput.addEventListener('input', function () {
      var v = cardInput.value.replace(/\D/g, '').slice(0, 19);
      cardInput.value = v.replace(/(.{4})/g, '$1 ').trim();
    });

    form.addEventListener('submit', async function (e) {
      e.preventDefault();
      window.setLoading(btn, true);
      var r = await window.api('/api/balance/topup', {
        amount: Number(amountInput.value),
        cardNumber: cardInput.value
      });
      window.setLoading(btn, false);
      if (r.ok) {
        document.getElementById('curBalance').textContent = r.balance.toFixed(2) + ' ₼';
        window.toast(r.message, 'success');
        setTimeout(function () { window.location.reload(); }, 1200);
      } else {
        window.toast(r.message || 'Xəta', 'error');
      }
    });
  })();
</script>
