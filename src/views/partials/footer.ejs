<footer class="footer">
  <div class="container">
    <div class="footer__top">
      <div class="footer__brand">
        <img src="/public/assets/logo-white.svg" alt="ADY" class="footer__logo" />
        <p class="footer__desc">
          <%= locale === 'en' ? 'Azerbaijan Railways — official online ticket service. Buy train tickets, check the timetable and manage your trips.' : (locale === 'ru' ? 'Азербайджанские Железные Дороги — официальный сервис онлайн-продажи билетов.' : 'Azərbaycan Dəmir Yolları — rəsmi onlayn bilet xidməti. Qatar biletlərini al, hərəkət cədvəlini izlə və səfərlərini idarə et.') %>
        </p>
        <div class="footer__contacts">
          <a href="tel:<%= site.supportPhone.replace(/\s/g,'') %>"><%= site.supportPhone %></a>
          <a href="mailto:<%= site.supportEmail %>"><%= site.supportEmail %></a>
          <span><%= site.address %></span>
        </div>
      </div>

      <div class="footer__cols">
        <div class="footer__col">
          <h4><%= t('nav.tickets') %></h4>
          <a href="/<%= locale %>/bilet-axtar"><%= t('nav.tickets') %></a>
          <a href="/<%= locale %>/hereket-cedveli"><%= t('nav.timetable') %></a>
          <a href="/<%= locale %>/populyar-istiqametler"><%= t('nav.destinations') %></a>
          <a href="/<%= locale %>/bilet-yoxlama"><%= locale === 'en' ? 'Verify ticket' : (locale === 'ru' ? 'Проверка билета' : 'Bilet yoxlanışı') %></a>
        </div>
        <div class="footer__col">
          <h4><%= t('nav.tariffs') %></h4>
          <a href="/<%= locale %>/tarifler-ve-odenis"><%= t('nav.tariffs') %></a>
          <a href="/<%= locale %>/tarifler-ve-odenis/gedis-haqqinin-qaytarilmasi"><%= locale === 'en' ? 'Refunds' : (locale === 'ru' ? 'Возврат средств' : 'Gediş haqqının qaytarılması') %></a>
          <a href="/<%= locale %>/tarifler-ve-odenis/odenis-usullari"><%= locale === 'en' ? 'Payment methods' : (locale === 'ru' ? 'Способы оплаты' : 'Ödəniş üsulları') %></a>
          <a href="/<%= locale %>/balans-artirilmasi"><%= t('nav.balance') %></a>
        </div>
        <div class="footer__col">
          <h4><%= t('nav.rules') %></h4>
          <a href="/<%= locale %>/dasima-qaydalari/usaqlarla-seyahet"><%= locale === 'en' ? 'Travelling with children' : (locale === 'ru' ? 'Путешествие с детьми' : 'Uşaqlarla səyahət') %></a>
          <a href="/<%= locale %>/dasima-qaydalari/el-yuklerinin-dasinmasi"><%= locale === 'en' ? 'Hand luggage' : (locale === 'ru' ? 'Ручная кладь' : 'Əl yüklərinin daşınması') %></a>
          <a href="/<%= locale %>/dasima-qaydalari/heyvanlarin-dasinmasi"><%= locale === 'en' ? 'Pets' : (locale === 'ru' ? 'Перевозка животных' : 'Heyvanların daşınması') %></a>
          <a href="/<%= locale %>/komek"><%= t('nav.help') %></a>
        </div>
        <div class="footer__col">
          <h4><%= t('nav.contact') %></h4>
          <a href="/<%= locale %>/elaqe"><%= t('nav.contact') %></a>
          <a href="/<%= locale %>/haqqimizda"><%= locale === 'en' ? 'About us' : (locale === 'ru' ? 'О нас' : 'Haqqımızda') %></a>
          <a href="/<%= locale %>/xeberler"><%= t('nav.news') %></a>
        </div>
      </div>

      <div class="footer__subscribe">
        <h4><%= t('footer.subscribe') %></h4>
        <form id="subscribeForm" class="subscribe">
          <input type="email" name="email" placeholder="E-poçt" required />
          <button type="submit" class="btn btn--gold"><%= t('footer.subscribeBtn') %></button>
        </form>
        <p class="footer__note" id="subscribeNote"></p>
        <div class="footer__pay">
          <span>Visa</span><span>Mastercard</span><span>MilliKart</span>
        </div>
      </div>
    </div>

    <div class="footer__bottom">
      <span>© <%= year %> <%= site.fullName %>. Bütün hüquqlar qorunur.</span>
      <span class="footer__built">Node.js · Express · MongoDB</span>
    </div>
  </div>
</footer>
