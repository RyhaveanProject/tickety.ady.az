<footer class="footer">
  <div class="container">
    <div class="footer__top">
      <div class="footer__brand">
        <img src="/assets/ady/logo-white.svg" alt="ADY — Azərbaycan Dəmir Yolları" class="footer__logo" />
        <p class="footer__desc"><%= t('footer.desc') %></p>
        <div class="footer__contacts">
          <a href="tel:<%= site.supportPhone %>">Çağrı mərkəzi: <%= site.supportPhone %></a>
          <a href="mailto:<%= site.supportEmail %>"><%= site.supportEmail %></a>
          <span><%= site.address %></span>
        </div>
        <% if (socials && socials.length) { %>
          <div class="footer__socials">
            <% socials.forEach(function(s){ %>
              <a href="<%= s.url %>" target="_blank" rel="noopener" title="<%= s.name %>">
                <img src="/assets/ady/social-<%= s.key %>.svg" alt="<%= s.name %>" />
              </a>
            <% }) %>
          </div>
        <% } %>
        <div class="footer__apps">
          <a href="<%= apps && apps.play || '#' %>" target="_blank" rel="noopener"><img src="/assets/ady/google-play.svg" alt="Google Play" /></a>
          <a href="<%= apps && apps.apple || '#' %>" target="_blank" rel="noopener"><img src="/assets/ady/app-store.svg" alt="App Store" /></a>
        </div>
      </div>

      <div class="footer__cols">
        <div class="footer__col">
          <h4><%= t('nav.tickets') %></h4>
          <a href="/<%= locale %>/bilet-axtar"><%= t('nav.tickets') %></a>
          <a href="/<%= locale %>/hereket-cedveli"><%= t('nav.timetable') %></a>
          <a href="/<%= locale %>/populyar-istiqametler"><%= t('nav.destinations') %></a>
          <a href="/<%= locale %>/bilet-yoxlama"><%= t('nav.verify') %></a>
        </div>
        <div class="footer__col">
          <h4><%= t('nav.tariffs') %></h4>
          <a href="/<%= locale %>/tarifler-ve-odenis/gedis-haqqi-tarifleri"><%= t('footer.fares') %></a>
          <a href="/<%= locale %>/tarifler-ve-odenis/gedis-haqqinin-qaytarilmasi"><%= t('footer.refund') %></a>
          <a href="/<%= locale %>/tarifler-ve-odenis/odenis-usullari"><%= t('footer.paymentMethods') %></a>
          <a href="/<%= locale %>/balans-artirilmasi"><%= t('nav.balance') %></a>
        </div>
        <div class="footer__col">
          <h4>Sualım var</h4>
          <a href="/<%= locale %>/sualim-var/suallar">Suallar</a>
          <a href="/<%= locale %>/dasima-qaydalari/usaqlarla-seyahet"><%= t('nav.children') %></a>
          <a href="/<%= locale %>/dasima-qaydalari/el-yuklerinin-dasinmasi"><%= t('nav.luggage') %></a>
          <a href="/<%= locale %>/dasima-qaydalari/heyvanlarin-dasinmasi"><%= t('nav.pets') %></a>
          <a href="/<%= locale %>/komek"><%= t('nav.help') %></a>
        </div>
        <div class="footer__col">
          <h4>Stansiyalar və dayanacaqlar</h4>
          <a href="/<%= locale %>/stansiya-ve-vagzallar/stansiya-ve-vagzallar"><%= t('footer.stationsTitle') %></a>
          <a href="/<%= locale %>/stansiya-ve-vagzallar/marsrutlar"><%= t('footer.routes') %></a>
          <a href="/<%= locale %>/haqqimizda"><%= t('nav.about') %></a>
          <a href="/<%= locale %>/elaqe"><%= t('nav.contact') %></a>
        </div>
      </div>

      <div class="footer__subscribe">
        <h4><%= t('footer.subscribe') %></h4>
        <form id="subscribeForm" class="subscribe">
          <input type="email" name="email" placeholder="<%= t('footer.email') %>" required />
          <button type="submit" class="btn btn--gold"><%= t('footer.subscribeBtn') %></button>
        </form>
        <p class="footer__note" id="subscribeNote"></p>
        <div class="footer__pay">
          <span>Visa</span><span>Mastercard</span><span>MilliKart</span>
        </div>
      </div>
    </div>

    <div class="footer__bottom">
      <span>© <%= year %> "Azərbaycan Dəmir Yolları" QSC. Bütün hüquqlar qorunur.</span>
      <span><a href="tel:1822" style="color:#f2a900">1822</a></span>
    </div>
  </div>
</footer>
