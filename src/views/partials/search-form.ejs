<form class="searchbar" id="searchForm" action="/<%= locale %>/reysler" method="GET">
  <div class="searchbar__field">
    <label><%= t('search.from') %></label>
    <div class="combo" data-combo>
      <input type="text" name="from" id="fromInput" placeholder="<%= t('search.selectStation') %>" autocomplete="off"
             value="<%= typeof prefill !== 'undefined' && prefill ? prefill.from : '' %>" required data-combo-input />
      <button type="button" class="combo__clear" data-combo-clear aria-label="Təmizlə">×</button>
      <div class="combo__list" data-combo-list></div>
    </div>
  </div>

  <button type="button" class="searchbar__swap" id="swapBtn" aria-label="Yerləri dəyiş">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 3 4 7l4 4"/><path d="M4 7h16"/><path d="m16 21 4-4-4-4"/><path d="M20 17H4"/></svg>
  </button>

  <div class="searchbar__field">
    <label><%= t('search.to') %></label>
    <div class="combo" data-combo>
      <input type="text" name="to" id="toInput" placeholder="<%= t('search.selectStation') %>" autocomplete="off"
             value="<%= typeof prefill !== 'undefined' && prefill ? prefill.to : '' %>" required data-combo-input />
      <button type="button" class="combo__clear" data-combo-clear aria-label="Təmizlə">×</button>
      <div class="combo__list" data-combo-list></div>
    </div>
  </div>

  <div class="searchbar__field">
    <label><%= t('search.date') %></label>
    <input type="date" name="date" id="dateInput"
           value="<%= typeof prefill !== 'undefined' && prefill ? prefill.date : (typeof today !== 'undefined' ? today : '') %>"
           min="<%= typeof today !== 'undefined' ? today : '' %>" max="<%= typeof maxDate !== 'undefined' ? maxDate : '' %>" required />
  </div>

  <div class="searchbar__field searchbar__field--sm">
    <label><%= t('search.passengers') %></label>
    <select name="passengers">
      <% [1,2,3,4].forEach(function(n){ %>
        <option value="<%= n %>" <%= (typeof prefill !== 'undefined' && prefill && prefill.passengers === n) ? 'selected' : '' %>><%= n %></option>
      <% }) %>
    </select>
  </div>

  <button type="submit" class="btn btn--primary btn--lg searchbar__submit">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
    <%= t('search.submit') %>
  </button>
</form>
<script>
  window.ADY_STATIONS = <%- JSON.stringify(typeof stations !== 'undefined' ? stations.map(function(s){ return { code: s.code, name: s.name, nameEn: s.nameEn, region: s.region }; }) : []) %>;
</script>
