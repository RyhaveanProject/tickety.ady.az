<section class="section">
  <div class="container">
    <div class="section__head">
      <div>
        <div class="eyebrow"><%= order.orderNo %></div>
        <h1><%= t('payment.title') %></h1>
        <p><%= order.fromName %> — <%= order.toName %> · <%= order.date %> · <%= order.passengers.length %> <%= t('checkout.passenger') %></p>
      </div>
    </div>

    <div class="steps">
      <div class="step is-active"><strong>1. Kart məlumatları</strong>Sifariş üçün kart daxil edilir</div>
      <div class="step"><strong>2. Təsdiq</strong>Ödəniş yoxlanılır</div>
      <div class="step"><strong>3. 3-D Secure</strong>Doğrulama kodu</div>
      <div class="step"><strong>4. Bilet</strong>Elektron bilet verilir</div>
    </div>

    <div class="layout-aside">
      <div>
        <div class="card"><div class="card__body">
          <div id="formNote" class="hidden"></div>

          <div class="pay-methods">
            <button type="button" class="pay-method is-active" data-pay-method="card">
              <svg class="ico" viewBox="0 0 24 24"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/></svg>
              <%= t('payment.methodCard') %>
            </button>
            <button type="button" class="pay-method" data-pay-method="balance">
              <svg class="ico" viewBox="0 0 24 24"><path d="M3 7h18v12H3z"/><path d="M3 11h18"/><circle cx="17" cy="15" r="1.4"/></svg>
              <%= t('payment.methodBalance') %> — <%= balance.toFixed(2) %> ₼
            </button>
          </div>

          <form id="payForm" data-order-id="<%= order._id %>">
            <div class="card-visual">
              <div class="flex-between">
                <span class="card-visual__brand" id="visualBrand">KART</span>
                <svg width="34" height="22" viewBox="0 0 34 22" aria-hidden="true"><rect width="34" height="22" rx="3" fill="#f2a900"/><path d="M0 7h34M0 15h34" stroke="#3a2600" stroke-width="1.4"/></svg>
              </div>
              <div class="card-visual__number" id="visualNumber">•••• •••• •••• ••••</div>
              <div class="card-visual__row">
                <span id="visualHolder">KART SAHİBİ</span>
                <span id="visualExpiry">AA/İİ</span>
              </div>
            </div>

            <div class="field">
              <label for="cardNumber"><%= t('payment.cardNumber') %></label>
              <input type="text" id="cardNumber" name="cardNumber" data-card-number placeholder="0000 0000 0000 0000" inputmode="numeric" required />
            </div>
            <div class="field">
              <label for="cardHolder"><%= t('payment.cardHolder') %></label>
              <input type="text" id="cardHolder" name="cardHolder" placeholder="AD SOYAD" required />
            </div>
            <div class="field--row">
              <div class="field">
                <label for="cardExpiry"><%= t('payment.expiry') %></label>
                <input type="text" id="cardExpiry" name="cardExpiry" data-card-expiry placeholder="AA/İİ" inputmode="numeric" required />
              </div>
              <div class="field">
                <label for="cardCvv"><%= t('payment.cvv') %></label>
                <input type="password" id="cardCvv" name="cardCvv" data-card-cvv placeholder="000" inputmode="numeric" required />
              </div>
            </div>

            <div class="alert alert--info text-sm"><%= t('payment.secure') %></div>

            <button type="submit" class="btn btn--primary btn--block btn--lg"><%= t('payment.pay') %> — <%= order.total.toFixed(2) %> ₼</button>
          </form>
        </div></div>
      </div>

      <div class="summary">
        <div class="card"><div class="card__body">
          <h3 style="font-size:1rem"><%= t('checkout.summary') %></h3>
          <div class="summary__row"><span><%= t('results.train') %></span><span><%= order.trainNumber %></span></div>
          <div class="summary__row"><span><%= t('common.date') %></span><span><%= order.date %></span></div>
          <div class="summary__row"><span><%= t('table.depart') %></span><span><%= order.departTime %></span></div>
          <% order.passengers.forEach(function(p){ %>
            <div class="summary__row"><span><%= t('seats.wagon') %> <%= p.wagon %> · <%= p.seat %> — <%= p.className %></span><span class="mono"><%= p.price.toFixed(2) %> ₼</span></div>
          <% }) %>
          <div class="summary__total"><span><%= t('checkout.total') %></span><span class="mono"><%= order.total.toFixed(2) %> ₼</span></div>
        </div></div>
      </div>
    </div>
  </div>
</section>
